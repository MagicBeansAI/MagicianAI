# .env.example for skill `metabase-mcp`
# Filled per scope into <scope>/skills/metabase-mcp/config/.env by setup-env.
# METABASE_BASE_URL is this workspace's Metabase origin (https://host, no path);
# the shared SKILL.md's ${METABASE_BASE_URL} endpoint and OAuth issuer resolve
# from it at load. No API key: access is the signed-in user's OAuth session.
METABASE_BASE_URL=
