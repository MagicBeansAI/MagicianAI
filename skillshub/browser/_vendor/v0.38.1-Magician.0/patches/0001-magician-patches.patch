+        Some(77) => "CloakBrowser license key is missing, invalid, or expired; set a valid CLOAKBROWSER_LICENSE_KEY",
+        Some(78) => "CloakBrowser could not reach its license server; check network access and retry",
+        Some(79) => "CloakBrowser local license configuration is invalid; inspect the local CloakBrowser installation and configuration",
+        _ => "CloakBrowser terminated before its CDP endpoint became usable",
+    };
+    format!("{base}: {explanation}")
+}
