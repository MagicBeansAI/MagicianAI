+    state: &DaemonState,
+    destination: &std::path::Path,
+) -> Result<Value, String> {
+    use base64::Engine;
+    const LIMIT: usize = 16 * 1024 * 1024;
+    let (object_id, target_session) = super::element::resolve_element_object_id(
+        &mgr.client, session_id, &state.ref_map, selector, &state.iframe_sessions,
+    ).await?;
+    let response = mgr.client.send_command("Runtime.callFunctionOn", Some(json!({
+        "objectId": object_id,
+        "functionDeclaration": r#"async function() {
+            if (!(this instanceof HTMLAnchorElement) || !this.hasAttribute('href'))
+                throw new Error('Extension downloads require a concrete link; script-triggered buttons are unsupported');
+            const url = new URL(this.href, location.href);
+            if (!['http:', 'https:', 'blob:', 'data:'].includes(url.protocol))
+                throw new Error('Unsupported download URL scheme');
+            const controller = new AbortController();
+            const timer = setTimeout(() => controller.abort(), 25000);
+            const limit = 16777216;
+            try {
+                const response = await fetch(url.href, {credentials: 'include', signal: controller.signal});
+                if (!response.ok || !response.body) throw new Error('Download HTTP status ' + response.status);
+                if (Number(response.headers.get('content-length')) > limit) throw new Error('Extension download exceeds 16 MiB');
+                const reader = response.body.getReader();
+                const chunks = []; let size = 0;
+                while (true) {
+                    const part = await reader.read(); if (part.done) break;
+                    size += part.value.length;
+                    if (size > limit) { await reader.cancel(); throw new Error('Extension download exceeds 16 MiB'); }
+                    for (let offset = 0; offset < part.value.length; offset += 8192)
+                        chunks.push(String.fromCharCode(...part.value.subarray(offset, offset + 8192)));
+                }
+                return {body: btoa(chunks.join('')), size};
+            } finally {clearTimeout(timer); controller.abort();}
