+fn find_new_stable_download(
+    directory: &std::path::Path,
+    pre_existing: &HashSet<std::ffi::OsString>,
+    observed_sizes: &mut HashMap<PathBuf, u64>,
+) -> Option<(PathBuf, u64)> {
+    for entry in fs::read_dir(directory).ok()?.flatten() {
+        let name = entry.file_name();
+        if pre_existing.contains(&name) { continue; }
+        let name_string = name.to_string_lossy();
+        if name_string.ends_with(".crdownload") || name_string.ends_with(".tmp") { continue; }
+        let path = entry.path();
+        let size = match entry.metadata() { Ok(metadata) => metadata.len(), Err(_) => continue };
+        if size == 0 { observed_sizes.insert(path, size); continue; }
+        if observed_sizes.insert(path.clone(), size) == Some(size) { return Some((path, size)); }
+    }
+    None
+}
