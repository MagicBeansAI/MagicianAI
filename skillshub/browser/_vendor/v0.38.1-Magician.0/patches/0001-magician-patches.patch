+fn truncate_session_component_to_bytes(value: &str, max_bytes: usize) -> String {
+    let mut truncated = String::new();
+    for c in value.chars() {
+        if truncated.len() + c.len_utf8() > max_bytes {
+            break;
+        }
+        truncated.push(c);
+    }
+    while truncated.ends_with(['-', '_']) {
+        truncated.pop();
+    }
+    truncated
+}
+
+fn build_scoped_session_id(
+    prefix: Option<&str>,
+    suffix: &str,
+    socket_dir: &std::path::Path,
+) -> Result<(String, bool), String> {
+    let desired = match prefix {
+        Some(prefix) => format!("{}-{}", prefix, suffix),
+        None => suffix.to_string(),
+    };
+
+    #[cfg(not(unix))]
+    {
+        let _ = socket_dir;
+        return Ok((desired, false));
+    }
+
+    #[cfg(unix)]
+    {
+        let max_session_bytes = connection::max_session_name_bytes_for_socket_dir(socket_dir);
+        if desired.len() <= max_session_bytes {
+            return Ok((desired, false));
+        }
+        if suffix.len() > max_session_bytes {
+            return Err(format!(
+                "Socket directory '{}' leaves only {} bytes for a session name, but the stable session suffix requires {}. Shorten --namespace or set AGENT_BROWSER_SOCKET_DIR to a shorter path.",
+                socket_dir.display(),
+                max_session_bytes,
+                suffix.len()
+            ));
+        }
+
+        let Some(prefix) = prefix else {
+            return Ok((suffix.to_string(), false));
+        };
+        let max_prefix_bytes = max_session_bytes.saturating_sub(suffix.len() + 1);
+        let prefix = truncate_session_component_to_bytes(prefix, max_prefix_bytes);
+        if prefix.is_empty() {
+            Ok((suffix.to_string(), true))
+        } else {
+            Ok((format!("{}-{}", prefix, suffix), true))
+        }
+    }
+}
