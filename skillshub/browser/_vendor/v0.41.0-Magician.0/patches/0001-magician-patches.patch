+/// A close acknowledgement precedes daemon cleanup. Reconnecting immediately
+/// can reuse that doomed daemon, then silently lose the new snapshot refs.
+/// Wait only after an actual close, pin the old owner, and never kill anything.
+fn wait_for_closed_daemon(session: &str, owner_pid: Option<&str>, timeout: Duration) -> Result<(), String> {
+    let started = Instant::now();
+    loop {
+        let current = fs::read_to_string(get_pid_path(session)).ok();
+        let finished = match owner_pid {
+            Some(owner) => current.as_deref() != Some(owner),
+            None => !daemon_ready(session),
+        };
+        if finished { return Ok(()); }
+        if started.elapsed() >= timeout {
+            return Err("Browser closed, but its daemon has not finished shutting down".into());
+        }
+        thread::sleep(Duration::from_millis(10));
+    }
 }
 
