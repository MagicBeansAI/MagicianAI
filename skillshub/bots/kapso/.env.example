# Kapso WhatsApp Bot (official Meta Cloud API via Kapso)
# Get credentials from https://app.kapso.ai → Project Settings

# Kapso API key (required)
# KAPSO_API_KEY=kps_...

# Kapso phone number ID (required — from Kapso WhatsApp numbers list)
# KAPSO_PHONE_NUMBER_ID=123456789012345

# Kapso number-webhook signing secret (required — Project Settings → Webhooks).
# Used to verify X-Webhook-Signature before any inbound payload is trusted.
# KAPSO_WEBHOOK_SECRET=wh_sec_...

# Port for the webhook server (default: 3010)
# WEBHOOK_PORT=3010

# Magician backend URL (default: http://127.0.0.1:3002)
# MAGICIAN_URL=http://127.0.0.1:3002

# Magician API credential: NOT set here. The runtime mints a scoped,
# in-memory token and injects MAGICIAN_BEARER_TOKEN when it spawns this
# bot, then revokes it on stop — so there is no credential at rest and
# nothing to rotate. A value set here is overridden by the injected one.

# Enable real-time WebSocket streaming (default: true)
# MAGICIAN_REALTIME_ENABLED=true

# Explicit owner-control prefix (default: @magic). Ordinary inbound Kapso
# messages are still dispatched to a per-sender envoy thread, but with a
# chat-only policy. Prefix a message with this tag to enter private assistant mode.
# MAGICIAN_CONTROL_PREFIX=@magic

# Ordinary non-control Kapso chat replies are model-routed by the backend via
# llm.router.operation_mapping.kapso_envoy_chat. The bot only sends
# source_surface=kapso-envoy-chat, which strips tool/delegation access for the
# turn while preserving the thread, transcript, memory episode, and LLM
# observability.

# Outside the 24-hour customer-service window, Meta blocks free-form replies and
# only allows pre-approved message templates. When set, an outside-window reply
# is re-sent through this template instead of being dropped (the bot never
# crashes either way). Ordinary non-control envoy-chat replies suppress this
# fallback; control replies still use it. Use the template NAME (not its numeric
# id). The reply text is passed into the template's {{1}} body variable if it has
# one; a static template (no variables) is sent as-is.
# KAPSO_FALLBACK_TEMPLATE_NAME=message_acceptance
# Template language code — must match how the template was created (e.g. en_US, en). Default: en_US
# KAPSO_FALLBACK_TEMPLATE_LANG=en_US
