# Telegram Bot — required
TELEGRAM_TOKEN=your-bot-token-from-botfather

# Magician backend URL (default: http://127.0.0.1:3002)
# MAGICIAN_URL=http://127.0.0.1:3002

# Magician API credential: NOT set here. The runtime mints a scoped,
# in-memory token and injects MAGICIAN_BEARER_TOKEN when it spawns this
# bot, then revokes it on stop — so there is no credential at rest and
# nothing to rotate. A value set here is overridden by the injected one.

# Enable real-time WebSocket streaming (default: true)
# MAGICIAN_REALTIME_ENABLED=true

# Drop updates that arrived while the bot was offline (default: false)
# TELEGRAM_DROP_PENDING_UPDATES=false
