# Gmail Bot (gws-based)
# Each instance needs its own GWS config dir for multi-account support.
# Run `CLOUDSDK_CONFIG=<dir>/cloudsdk GOOGLE_WORKSPACE_CLI_CONFIG_DIR=<dir> gws auth setup --login` once per account.

# Google Workspace CLI config directory for this account profile.
# From bots/gmail/, the scoped auth dirs live at ../../auth/gws-<account>.
# The bot derives CLOUDSDK_CONFIG as <GWS_CONFIG_DIR>/cloudsdk so gcloud logs do
# not land in the scoped runtime home.
# The shared OAuth client secret is kept once at ../../config/gws/client_secret.json
# and linked into each auth profile automatically.
# If the stored refresh token is revoked, the bot now treats that as invalid auth
# and will re-open the login flow instead of looping with a false "auth verified".
# The bot auto-derives GOOGLE_WORKSPACE_PROJECT_ID from that client_secret.json.
# Set it explicitly only if you need to override the stored project id.
# GOOGLE_WORKSPACE_PROJECT_ID=magician-gws
# GWS_CONFIG_DIR=../../auth/gws-work
# GWS_PROFILE_LABEL=Work
# GWS_EXPECTED_EMAIL=user@example.com
# When true, retry-driven auth failures preserve the auth directory and require
# Bot Control re-authentication instead of deleting stored credentials.
# GWS_REQUIRE_MANAGED_AUTH=true

# Magician backend URL (default: http://127.0.0.1:3002)
# MAGICIAN_URL=http://127.0.0.1:3002

# Magician API credential: NOT set here. The runtime mints a scoped,
# in-memory token and injects MAGICIAN_BEARER_TOKEN when it spawns this
# bot, then revokes it on stop — so there is no credential at rest and
# nothing to rotate. A value set here is overridden by the injected one.

# Enable real-time WebSocket streaming (default: true)
# MAGICIAN_REALTIME_ENABLED=true
