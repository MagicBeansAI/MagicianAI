# WhatsApp Bot (wu-cli based)
# Auth is handled automatically on startup:
#   - If WHATSAPP_PHONE is set: pairing code mode (code shown in bot logs)
#   - If not set: QR code mode (QR shown in bot logs)
# Check Presto UI → bot logs to see the code/QR and complete pairing.

# Your phone number with country code (enables pairing code auth — no QR scan needed)
# WHATSAPP_PHONE=+1234567890

# Magician backend URL (default: http://127.0.0.1:3002)
# MAGICIAN_URL=http://127.0.0.1:3002

# Magician API credential: NOT set here. The runtime mints a scoped,
# in-memory token and injects MAGICIAN_BEARER_TOKEN when it spawns this
# bot, then revokes it on stop — so there is no credential at rest and
# nothing to rotate. A value set here is overridden by the injected one.

# Enable real-time WebSocket streaming (default: true)
# MAGICIAN_REALTIME_ENABLED=true

# Personal WhatsApp self-chat is never forwarded into Magician chat/control.
# Messages to yourself stay ordinary WhatsApp history for observation/distillation.
# Use Kapso with the configured control prefix (default /magic; legacy @magic
# also works) for Magician control from WhatsApp.

# Your WhatsApp JID (auto-detected from wu status; set manually as fallback)
# WHATSAPP_SELF_JID=1234567890@s.whatsapp.net
