# AgentMail inbound bot (verified email → Magician → threaded reply)
# Get the API key from https://agentmail.to — it is inbox-scoped to
# magican@agentmail.to, so the webhook only fires for that inbox.

# AgentMail API key (required)
# AGENT_MAIL_KEY=am_us_inbox_xxxx

# Port for the webhook server (default: 3011)
# WEBHOOK_PORT=3011

# Public BASE URL AgentMail can reach. Defaults to https://${MAGICIAN_WEBHOOK_HOST}
# (the machine's tunnel webhook host, inherited from the runtime env); set this
# only to override it. The webhook is served at /agentmail-webhook — distinct
# from the kapso bot's /webhook so both bots share one public host; the tunnel
# path-splits ^/agentmail-webhook/?$ to WEBHOOK_PORT. On startup the bot
# self-registers <url>/agentmail-webhook (re-pointing a moved URL) and takes its
# signing secret from AgentMail; with no URL at all, AGENTMAIL_WEBHOOK_SECRET is
# required and you register the webhook yourself.
# AGENTMAIL_WEBHOOK_URL=https://webhook.example.com

# Webhook signing secret (whsec_...) for mandatory Svix signature verification.
# Set this for a manually registered webhook. Automatic registration obtains
# its secret from AgentMail when this is unset. Startup fails if neither path
# supplies a secret; unsigned or invalidly signed events are always refused.
# AGENTMAIL_WEBHOOK_SECRET=whsec_...

# Magician API credential: NOT set here. The runtime mints a scoped,
# in-memory token and injects MAGICIAN_BEARER_TOKEN when it spawns this
# bot, then revokes it on stop — so there is no credential at rest and
# nothing to rotate. A value set here is overridden by the injected one.
