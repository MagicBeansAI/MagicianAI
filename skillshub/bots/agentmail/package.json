{
  "name": "@magician/bot-agentmail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm --prefix ../.. run build -w @magician/bot-sdk && node ../build_bundle.mjs",
    "check": "npm --prefix ../.. run build -w @magician/bot-sdk && tsc -p tsconfig.json --noEmit",
    "start": "node --env-file=${ENV_FILE:-.env.development} dist/index.js",
    "test": "npm --prefix ../.. run build -w @magician/bot-sdk && tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@magician/bot-sdk": "file:../sdk",
    "agentmail": "^0.0.46",
    "express": "^5.1.0",
    "svix": "^1.45.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0"
  }
}
