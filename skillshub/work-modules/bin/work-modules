#!/usr/bin/env python3
"""work-modules — the agent's hands on the composable work modules.

Doc: `docs/plans/2026-08-07-opc-composable-work-modules.md` §5 and §7.

Every module below already had an owner HTTP surface. What it did not have was
an AGENT-facing one, and §5 says why that is not the same thing: *"an
agent-facing capability, not an HTTP route: these are what a worker agent
calls"*. A route an owner curls is a surface a person operates; an agent that
cannot reach it cannot run the cycle §7 describes, and the modules stay a set of
stores nobody fills.

This adapter is deliberately thin. It owns no judgement and holds no state: it
maps one typed action onto one route, and every rule about what may be recorded
stays in the store behind it. Two consequences worth stating plainly, because
they are the reason this is safe to hand an agent:

- **`submit` is not here.** Submission is a submission-class act — public and
  irreversible — and the plan is explicit: the agent drafts the whole thing and
  a person presses send. Leaving it out of the capability is the enforcement.
- **`obligations/sweep` is not here.** A sweep is operator maintenance over a
  whole scope, not a step in anybody's work.

Both remain reachable on the owner routes, which is exactly where they belong.

Transport is plain HTTP to the local runtime, so nothing here needs a CA bundle
— worth saying, because the governed runtime `env_clear`s `SSL_CERT_FILE` and
that has silently killed HTTPS-using skills before.

Self-contained: stdlib only. The governed SKILL.md action contract owns the
input shape; this file owns the mapping to a route.
"""

from __future__ import annotations

import json
import os
import socket
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_BASE = "http://127.0.0.1:3002"
API_ROOT = "/api/magician/v2"
MAX_RESPONSE_BYTES = 8 * 1024 * 1024
# Deliberately under the governed runtime's own 60s ceiling. If they matched,
# a slow runtime would get the process KILLED at the same instant this would
# have timed out — and a killed process hands the agent nothing, where a clean
# timeout hands it a reason it can act on.
TIMEOUT_SECS = 45
# `socket.timeout` IS `TimeoutError` from 3.10 and a distinct `OSError` subclass
# before it, so both are named rather than assuming either.
TIMEOUTS = (TimeoutError, socket.timeout)

# action -> (method, path template, body field names)
#
# A table rather than a function per action, so adding an action is one row and
# a route that moves is one edit. `{...}` segments are filled from the request
# and REMOVED from the body: a path parameter that also arrived in the JSON body
# would be sent twice and the two copies could disagree.
#
# Field lists are transcribed from the request structs in
# `magician-api/src/work_modules_api.rs`, not from what the API plausibly looks
# like. That distinction has already cost this codebase once: the outward
# restricted-action table was composed from a plausible mail API and every entry
# in it was wrong.
ROUTES: dict[str, tuple[str, str, tuple[str, ...]]] = {
    # ── Module C — a durable run, and what it is waiting for ──────────────
    "open_run": (
        "POST",
        "/work/runs",
        ("purpose", "resource_ref", "audience_kind", "audience_id", "fields", "opened_by"),
    ),
    "list_runs": ("GET", "/work/runs", ()),
    "read_run": ("GET", "/work/runs/{run_id}", ()),
    "declare_field": ("POST", "/work/runs/{run_id}/fields", ("name", "required")),
    "answer": ("POST", "/work/runs/{run_id}/answers", ("field", "text", "evidence_refs")),
    "raise_gap": ("POST", "/work/runs/{run_id}/gaps", ("field", "question")),
    "resolve_gap": (
        "POST",
        "/work/runs/{run_id}/gaps/resolve",
        ("field", "question", "text", "evidence_refs", "resolved_by"),
    ),
    "expect": ("POST", "/work/runs/{run_id}/expectations", ("description", "source_hint")),
    "fulfil_expectation": (
        "POST",
        "/work/runs/{run_id}/expectations/fulfil",
        ("event_ref", "source_hint", "at"),
    ),
    # ── Module A — agreeing a time with somebody outside ──────────────────
    "offer_times": (
        "POST",
        "/work/negotiations",
        ("audience_kind", "audience_id", "counterparty", "purpose", "slots", "offer_act_ref"),
    ),
    "list_negotiations": ("GET", "/work/negotiations", ("audience_kind", "audience_id")),
    "read_negotiation": (
        "GET",
        "/work/negotiations/{negotiation_id}",
        ("audience_kind", "audience_id"),
    ),
    "record_reply": (
        "POST",
        "/work/negotiations/{negotiation_id}/reply",
        ("audience_kind", "audience_id", "source_ref", "at", "reading",
         "starting_at", "reason", "slots"),
    ),
    "re_offer": (
        "POST",
        "/work/negotiations/{negotiation_id}/re-offer",
        ("audience_kind", "audience_id", "slots", "offer_act_ref"),
    ),
    "hold": (
        "POST",
        "/work/negotiations/{negotiation_id}/hold",
        ("audience_kind", "audience_id", "calendar_event_ref"),
    ),
    "reschedule": (
        "POST",
        "/work/negotiations/{negotiation_id}/reschedule",
        ("audience_kind", "audience_id", "reason"),
    ),
    "close": (
        "POST",
        "/work/negotiations/{negotiation_id}/close",
        ("audience_kind", "audience_id", "reason"),
    ),
    # ── Module D — what is owed, and by when ──────────────────────────────
    "record_obligation": (
        "POST",
        "/work/obligations",
        ("audience_kind", "audience_id", "program_id", "what", "due_at", "direction",
         "created_by", "source_act_ref"),
    ),
    "list_obligations": (
        "GET",
        "/work/obligations",
        ("audience_kind", "audience_id", "direction", "lapsed_only", "include_settled"),
    ),
    "settle_obligation": (
        "POST",
        "/work/obligations/{obligation_id}/settle",
        ("audience_kind", "audience_id", "settlement", "note", "reason"),
    ),
    # ── Module B substrate — which claims a revision carries ──────────────
    "bind_claims": (
        "POST",
        "/work/claim-manifests",
        ("artifact_ref", "revision_ref", "claims", "bound_by"),
    ),
    "read_manifest": ("GET", "/work/claim-manifests", ("artifact_ref", "revision_ref")),
    "carrying_claim": ("GET", "/work/claim-manifests/carrying", ("claim_ref", "latest_only")),
}

# Path parameters, by the name the request carries them under.
PATH_PARAMS = ("run_id", "negotiation_id", "obligation_id")


def base_url() -> str:
    return os.environ.get("MAGICIAN_API_BASE", DEFAULT_BASE).rstrip("/")


def build(action: str, request: dict) -> tuple[str, str, bytes | None]:
    """(method, url, body) for this action, or raise with a usable message."""
    if action not in ROUTES:
        known = ", ".join(sorted(ROUTES))
        raise ValueError(f"unknown action `{action}`; expected one of: {known}")
    method, template, fields = ROUTES[action]

    path = template
    for name in PATH_PARAMS:
        token = "{" + name + "}"
        if token not in path:
            continue
        value = str(request.get(name, "")).strip()
        if not value:
            raise ValueError(f"`{name}` is required for `{action}`")
        # Refused rather than escaped. A path segment that can traverse would
        # address a different resource than the caller named, and an id with a
        # slash in it is a bug upstream, not something to normalise away here.
        if "/" in value or ".." in value:
            raise ValueError(f"`{name}` must be an id, not a path")
        path = path.replace(token, urllib.parse.quote(value, safe=""))

    supplied = {
        name: request[name]
        for name in fields
        if name in request and request[name] is not None
    }

    scope = {
        key: request[key]
        for key in ("principal", "workspace")
        if request.get(key)
    }

    if method == "GET":
        query = {**scope}
        for name, value in supplied.items():
            # `true`/`false`, not Python's `True`/`False`: serde reads the
            # lowercase spelling and rejects the other.
            query[name] = "true" if value is True else "false" if value is False else str(value)
        url = f"{base_url()}{API_ROOT}{path}"
        if query:
            url = f"{url}?{urllib.parse.urlencode(query)}"
        return method, url, None

    body = {**scope, **supplied}
    return method, f"{base_url()}{API_ROOT}{path}", json.dumps(body).encode("utf-8")


def call(method: str, url: str, body: bytes | None, scope: dict) -> tuple[int, dict | str]:
    headers = {"Accept": "application/json"}
    # Sent as headers too, which is the house style and what `resolve_scope`
    # reads first. Belt and braces: a POST carries them in the body as well, and
    # the two agree because both come from one place above.
    if scope.get("principal"):
        headers["X-Principal"] = str(scope["principal"])
    if scope.get("workspace"):
        headers["X-Workspace"] = str(scope["workspace"])
    if body is not None:
        headers["Content-Type"] = "application/json"

    request = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT_SECS) as response:
            raw = response.read(MAX_RESPONSE_BYTES + 1)
            status = response.status
    except urllib.error.HTTPError as exc:
        raw = exc.read(MAX_RESPONSE_BYTES + 1)
        status = exc.code
    if len(raw) > MAX_RESPONSE_BYTES:
        raise ValueError("runtime response exceeds local size limit")
    text = raw.decode("utf-8", errors="replace")
    try:
        return status, json.loads(text)
    except json.JSONDecodeError:
        return status, text


def main() -> int:
    if len(sys.argv) < 2:
        sys.stderr.write("usage: work-modules <action>  (parameters as JSON on stdin)\n")
        return 64
    action = sys.argv[1]

    raw_stdin = sys.stdin.read().strip()
    try:
        request = json.loads(raw_stdin) if raw_stdin else {}
    except json.JSONDecodeError as exc:
        sys.stderr.write(f"[work-modules] status=failed reason=\"bad request json: {exc}\"\n")
        print(json.dumps({"status": "failed", "reason": f"bad request json: {exc}"}))
        return 0
    if not isinstance(request, dict):
        print(json.dumps({"status": "failed", "reason": "request must be a JSON object"}))
        return 0

    scope = {
        "principal": request.get("principal") or os.environ.get("MAGICIAN_PRINCIPAL"),
        "workspace": request.get("workspace") or os.environ.get("MAGICIAN_WORKSPACE"),
    }
    request = {**request, **{k: v for k, v in scope.items() if v}}

    started = time.monotonic()
    try:
        method, url, body = build(action, request)
        status_code, payload = call(method, url, body, scope)
        # A 4xx from these stores is a RULE, not a transport failure — a
        # submission that is not ready, an acceptance of a slot nobody offered,
        # a rebind that would change a revision's claims. It is carried through
        # verbatim so the agent can act on the sentence rather than retrying a
        # refusal it cannot read.
        status = "ok" if 200 <= status_code < 300 else "refused"
        reason = None if status == "ok" else "the store refused this; read `response`"
    except TIMEOUTS:
        status_code, payload = 0, None
        status, reason = (
            "failed",
            f"the local runtime did not answer within {TIMEOUT_SECS}s; it is running and slow, "
            "which is a different thing to fix than one that is down",
        )
    except urllib.error.URLError as exc:
        status_code, payload = 0, None
        # A timeout during connect arrives WRAPPED in a `URLError`, so it never
        # reaches the arm above. Reporting it as unreachable would send somebody
        # to check whether a process that is running is running.
        if isinstance(exc.reason, TIMEOUTS):
            status, reason = (
                "failed",
                f"the local runtime did not answer within {TIMEOUT_SECS}s; it is reachable "
                "and slow, which is a different thing to fix than one that is down",
            )
        else:
            status, reason = "failed", f"the local runtime is not reachable: {exc.reason}"
    except Exception as exc:  # noqa: BLE001
        status_code, payload = 0, None
        status, reason = "failed", f"{type(exc).__name__}: {exc}"
    duration_ms = int((time.monotonic() - started) * 1000)

    parts = [
        "[work-modules]",
        f"action={action}",
        f"status={status}",
        f"http={status_code}",
        f"duration_ms={duration_ms}",
    ]
    if reason:
        parts.append(f'reason="{reason}"')
    sys.stderr.write(" ".join(parts) + "\n")
    sys.stderr.flush()

    print(json.dumps({
        "action": action,
        "status": status,
        "http_status": status_code,
        "reason": reason,
        "response": payload,
        "duration_ms": duration_ms,
    }, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
