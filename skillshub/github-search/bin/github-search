#!/usr/bin/env python3
"""Bounded GitHub Search API adapter with optional governed authentication."""

from __future__ import annotations

import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone

ISSUES_URL = "https://api.github.com/search/issues"
REPOS_URL = "https://api.github.com/search/repositories"
MAX_INPUT_BYTES = 32 * 1024
MAX_RESPONSE_BYTES = 8 * 1024 * 1024


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, "redirect denied", headers, fp)


OPENER = urllib.request.build_opener(NoRedirect)


def read_input() -> dict:
    raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
    if len(raw) > MAX_INPUT_BYTES:
        raise ValueError("input exceeds adapter limit")
    value = json.loads(raw)
    if not isinstance(value, dict):
        raise ValueError("input must be a JSON object")
    return value


def get_json(url: str, headers: dict[str, str]) -> dict:
    request = urllib.request.Request(url, headers=headers)
    with OPENER.open(request, timeout=20) as response:
        raw = response.read(MAX_RESPONSE_BYTES + 1)
    if len(raw) > MAX_RESPONSE_BYTES:
        raise ValueError("provider response exceeds adapter limit")
    value = json.loads(raw)
    if not isinstance(value, dict):
        raise ValueError("provider response is not an object")
    return value


def text(value, limit: int) -> str:
    return value[:limit] if isinstance(value, str) else ""


def valid_http_url(value) -> str:
    value = text(value, 8_192)
    return value if value.startswith(("https://", "http://")) else ""


def within_window(published_at: str, from_date, to_date) -> bool:
    if not published_at:
        return True
    try:
        date = datetime.fromisoformat(published_at.replace("Z", "+00:00")).date()
    except ValueError:
        return True
    return from_date <= date <= to_date


# GitHub's issue search now REFUSES a query that does not say which of the two
# record kinds it wants:
#
#   422 {"message": "Query must include 'is:issue' or 'is:pull-request'"}
#
# The refusal reaches an authenticated request first, which is why this skill
# worked keyless and failed the moment a token was injected — a shape that looks
# like a credential problem and is not one. There is no combined form: `(is:issue
# OR is:pull-request)` is refused with the same message, and naming both bare
# silently keeps only the last qualifier. So covering the surface this skill
# documents — recent issues *and* pull requests — takes one search per kind,
# merged here.
#
# A caller that already pinned a kind in its own query gets exactly that one
# search, unaltered: appending a second qualifier to it would override the
# caller's choice rather than widen it.
ISSUE_KIND_QUALIFIERS = ("is:issue", "is:pull-request", "type:issue", "type:pr")


def requested_issue_kinds(query: str) -> tuple[str, ...]:
    lowered = query.lower()
    if any(qualifier in lowered for qualifier in ISSUE_KIND_QUALIFIERS):
        return ("",)
    return ("is:issue", "is:pull-request")


def fetch_issues(query: str, from_date, to_date, limit: int, headers: dict[str, str]) -> list[dict]:
    kinds = requested_issue_kinds(query)
    items: list[dict] = []
    seen: set[str] = set()
    # Each kind is asked for the full limit rather than a share of it, so a
    # window with only pull requests in it still fills the answer instead of
    # returning half of one.
    for kind in kinds:
        search = f"{query} created:{from_date.isoformat()}..{to_date.isoformat()}"
        if kind:
            search = f"{search} {kind}"
        params = {"q": search, "sort": "updated", "order": "desc", "per_page": min(limit, 30)}
        payload = get_json(f"{ISSUES_URL}?{urllib.parse.urlencode(params)}", headers)
        for item in payload.get("items") or []:
            if not isinstance(item, dict):
                continue
            identity = str(item.get("id") or "")
            if identity and identity in seen:
                continue
            if identity:
                seen.add(identity)
            items.append(item)
    # One ordering over the merged set. Each search returned its own
    # `sort=updated&order=desc` run, and concatenating two descending runs is
    # not a descending run — the second kind's newest record would land behind
    # the first kind's oldest, and truncating to `limit` would then drop recent
    # pull requests in favour of stale issues.
    items.sort(key=lambda item: text(item.get("updated_at") or item.get("created_at"), 64), reverse=True)
    output: list[dict] = []
    for item in items[:limit]:
        repo_url = text(item.get("repository_url"), 8_192)
        output.append({
            "title": text(item.get("title"), 2_048),
            "url": valid_http_url(item.get("html_url")),
            "snippet": text(item.get("body"), 1_200).strip(),
            "published_at": text(item.get("created_at"), 64) or None,
            "source": "github",
            "source_native_id": str(item.get("id") or "")[:128],
            "engagement": {
                "comments": int(item.get("comments") or 0),
                "reactions_total": int((item.get("reactions") or {}).get("total_count") or 0),
            },
            "author": text((item.get("user") or {}).get("login"), 256) or None,
            "container": text(repo_url.split("/repos/")[-1], 512) if "/repos/" in repo_url else None,
        })
    return output


def fetch_repos(query: str, from_date, to_date, limit: int, headers: dict[str, str]) -> list[dict]:
    params = {
        "q": f"{query} pushed:>={from_date.isoformat()}",
        "sort": "stars",
        "order": "desc",
        "per_page": min(limit, 30),
    }
    payload = get_json(f"{REPOS_URL}?{urllib.parse.urlencode(params)}", headers)
    output: list[dict] = []
    for repo in (payload.get("items") or [])[:limit]:
        if not isinstance(repo, dict):
            continue
        published = text(repo.get("pushed_at") or repo.get("updated_at") or repo.get("created_at"), 64)
        if not within_window(published, from_date, to_date):
            continue
        output.append({
            "title": text(repo.get("full_name") or repo.get("name"), 2_048),
            "url": valid_http_url(repo.get("html_url")),
            "snippet": text(repo.get("description"), 1_200).strip(),
            "published_at": published or None,
            "source": "github",
            "source_native_id": str(repo.get("id") or "")[:128],
            "engagement": {
                "stars": int(repo.get("stargazers_count") or 0),
                "forks": int(repo.get("forks_count") or 0),
                "open_issues": int(repo.get("open_issues_count") or 0),
            },
            "author": text((repo.get("owner") or {}).get("login"), 256) or None,
            "container": text(repo.get("full_name"), 512) or None,
        })
    return output


def main() -> int:
    started = time.monotonic()
    try:
        params = read_input()
        query = params["query"]
        days = params.get("days", 3)
        limit = params.get("limit", 10)
        mode = params.get("mode", "mixed")
        if not isinstance(query, str) or not query:
            raise ValueError("query is required")
        today = datetime.now(timezone.utc).date()
        from_date = today - timedelta(days=days)
        headers = {
            "User-Agent": "uuaa/github-search",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
        }
        token = os.environ.get("GITHUB_TOKEN", "").strip()
        if token:
            headers["Authorization"] = f"Bearer {token}"
        if mode == "issues":
            items = fetch_issues(query, from_date, today, limit, headers)
        elif mode == "repos":
            items = fetch_repos(query, from_date, today, limit, headers)
        else:
            issues_count = max(1, int(limit * 0.6))
            repos_count = max(1, limit - issues_count)
            items = fetch_issues(query, from_date, today, issues_count, headers)
            items += fetch_repos(query, from_date, today, repos_count, headers)
        output = {
            "query": query,
            "source": "github",
            "mode": mode,
            "from_date": from_date.isoformat(),
            "to_date": today.isoformat(),
            "items": items[:limit],
            "count": min(len(items), limit),
            "status": "ok",
            "reason": None,
            "duration_ms": int((time.monotonic() - started) * 1000),
        }
        print(json.dumps(output, sort_keys=True))
        return 0
    except urllib.error.HTTPError as error:
        reason = f"GitHub request failed with HTTP {error.code}"
    except (urllib.error.URLError, TimeoutError):
        reason = "GitHub request was unavailable"
    except (KeyError, TypeError, ValueError, json.JSONDecodeError):
        reason = "invalid GitHub search input or provider response"
    output = {
        "source": "github",
        "items": [],
        "count": 0,
        "status": "failed",
        "reason": reason,
        "duration_ms": int((time.monotonic() - started) * 1000),
    }
    print(json.dumps(output, sort_keys=True))
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
