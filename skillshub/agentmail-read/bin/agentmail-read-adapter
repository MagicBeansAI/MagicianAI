#!/bin/sh
# Snapshot-safe entrypoint for the agentmail-read skill.
#
# The governed runtime copies its entrypoint ALONE into a private temporary
# directory and runs that copy, so the official launcher cannot be the
# entrypoint: its JS launcher spawns the native .agentmail binary beside
# itself (path.join(__dirname, '.agentmail')).
#
# This file carries nothing relative to itself. It execs the declared PATH
# companion `agentmail` by name; the runtime puts this skill's reviewed bin/
# directory on the child's PATH and the companion runs in place, beside its
# real package files. argv is passed through unchanged.
if ! command -v agentmail >/dev/null 2>&1; then
  echo "agentmail-read: the pinned agentmail CLI is not installed (run: make setup-all)" >&2
  exit 127
fi
exec agentmail "$@"
