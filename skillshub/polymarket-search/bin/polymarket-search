#!/usr/bin/env python3
"""polymarket_search — active markets on a topic via Gamma API.

Keyless. Self-contained, stdlib only. Note: Polymarket's API doesn't
do server-side relevance filtering — we pull top-N active markets by
volume, then client-side filter to those whose question/description
contain query terms.
"""

from __future__ import annotations

import json
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone

USER_AGENT = "magician/polymarket_search/0.1"
MARKETS_URL = "https://gamma-api.polymarket.com/markets"
MAX_RESPONSE_BYTES = 4 * 1024 * 1024


def _read_json_response(response):
    raw = response.read(MAX_RESPONSE_BYTES + 1)
    if len(raw) > MAX_RESPONSE_BYTES:
        raise ValueError("provider response exceeds local size limit")
    return json.loads(raw)


def fetch(query: str, limit: int) -> list[dict]:
    params = {
        "active": "true",
        "closed": "false",
        "limit": 100,
        "order": "volume",
        "ascending": "false",
    }
    url = f"{MARKETS_URL}?{urllib.parse.urlencode(params, doseq=True)}"
    req = urllib.request.Request(
        url, headers={"User-Agent": USER_AGENT, "Accept": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        payload = _read_json_response(resp)
    markets = payload if isinstance(payload, list) else (payload or {}).get("markets") or []

    q_lower = query.lower()
    q_terms = [t for t in q_lower.split() if len(t) > 2]

    out: list[dict] = []
    for market in markets:
        question = (market.get("question") or market.get("title") or "").strip()
        description = (market.get("description") or "").strip()
        haystack = f"{question} {description}".lower()
        if q_lower not in haystack and not any(t in haystack for t in q_terms):
            continue
        slug = market.get("slug") or ""
        url = f"https://polymarket.com/event/{slug}" if slug else ""
        out.append({
            "title": question,
            "url": url,
            "snippet": description[:1200],
            "published_at": market.get("startDate"),
            "source": "polymarket",
            "source_native_id": str(market.get("id") or market.get("conditionId") or ""),
            "engagement": {
                "volume": float(market.get("volume") or 0),
                "liquidity": float(market.get("liquidity") or 0),
            },
            "author": None,
            "container": market.get("category") or None,
        })
        if len(out) >= limit:
            break
    return out


def main() -> int:
    request = json.load(sys.stdin)
    query = str(request["query"])
    limit = int(request.get("limit", 10))

    today = datetime.now(timezone.utc).date()

    started = time.monotonic()
    try:
        items = fetch(query, limit)
        status, reason = "ok", None
    except urllib.error.HTTPError as exc:
        items, status, reason = [], "failed", f"HTTP {exc.code}: {exc.reason}"
    except urllib.error.URLError as exc:
        items, status, reason = [], "failed", f"network: {exc.reason}"
    except Exception as exc:  # noqa: BLE001
        items, status, reason = [], "failed", f"{type(exc).__name__}: {exc}"
    duration_ms = int((time.monotonic() - started) * 1000)

    parts = ["[polymarket_search]", f"status={status}", f"count={len(items)}", f"duration_ms={duration_ms}"]
    if reason:
        parts.append(f'reason="{reason}"')
    sys.stderr.write(" ".join(parts) + "\n")
    sys.stderr.flush()

    envelope = {
        "query": query, "source": "polymarket",
        "to_date": today.isoformat(),
        "items": items, "count": len(items),
        "status": status, "reason": reason, "duration_ms": duration_ms,
    }
    print(json.dumps(envelope, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
