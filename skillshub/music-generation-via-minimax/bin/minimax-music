#!/usr/bin/env python3
"""MiniMax music generator — `mmx music generate` artifact adapter.

Subprocess-spawns the `mmx music generate` CLI with `--out <path>` so
the resulting audio file lands at the requested path. Returns a
structured JSON envelope matching the rest of the magician media-gen
pipeline.

Exactly one of:
  - `lyrics` (vocal song with explicit lyrics)
  - `instrumental=true` (no vocals)
  - `lyrics_optimizer=true` (auto-generated lyrics from prompt)
must be set.

Auth: reads `MMX_CONFIG_DIR` from env (injected by magician's secret
binding when invoked via a chat session) and lets `mmx` load credentials
from `<MMX_CONFIG_DIR>/config.json`.

Output: `--output json` is sent WITHOUT `--quiet`. The two are not
composable on this subcommand. `music generate --out` ends in a shared
writer whose last argument is the quiet flag: `if (quiet) console.log(path);
else console.log(format({saved, duration_ms, size_bytes, sample_rate},
output))` — the quiet branch wins and prints a bare filesystem path,
discarding the requested format. Sending both meant every *successful*
generation was reported as a failure ("mmx returned non-JSON stdout") after
the API had already billed and the audio file was already on disk. Dropping
`--quiet` adds nothing to stdout: the model banner and the update notice go
to stderr.
"""
import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile
import time


def log_event(message: str) -> None:
    print(f"[MINIMAX-MUSIC] {message}", file=sys.stderr, flush=True)


def _resolve_allowed_output_dirs() -> list[pathlib.Path]:
    candidates = [
        pathlib.Path(tempfile.gettempdir()),
        pathlib.Path("/tmp"),
        pathlib.Path("/private/tmp"),
        pathlib.Path.cwd(),
    ]
    seen: set[str] = set()
    resolved: list[pathlib.Path] = []
    for c in candidates:
        try:
            r = c.resolve()
        except Exception:
            continue
        key = str(r)
        if key in seen:
            continue
        seen.add(key)
        if r.exists():
            resolved.append(r)
    return resolved


ALLOWED_OUTPUT_DIRS = _resolve_allowed_output_dirs()


def validate_output_path(path_str: str) -> str:
    resolved = pathlib.Path(path_str).resolve()
    for allowed in ALLOWED_OUTPUT_DIRS:
        try:
            resolved.relative_to(allowed)
            return str(resolved)
        except ValueError:
            continue
    print(
        json.dumps(
            {
                "error": (
                    f"output_path must be within {ALLOWED_OUTPUT_DIRS[0]} "
                    f"or current working directory"
                )
            }
        )
    )
    sys.exit(1)


def normalize_optional_text(value: str) -> str:
    return (value or "").strip()


def parse_int(value: str, default: int | None, name: str) -> int | None:
    raw = normalize_optional_text(value)
    if not raw or raw.lower() == "none":
        return default
    try:
        return int(raw)
    except ValueError:
        print(json.dumps({"error": f"{name} must be an integer (got {raw!r})"}))
        sys.exit(1)


def parse_bool(value: str, default: bool) -> bool:
    raw = normalize_optional_text(value).lower()
    if not raw or raw == "none":
        return default
    if raw in ("true", "1", "yes", "y"):
        return True
    if raw in ("false", "0", "no", "n"):
        return False
    return default


def parse_mmx_stdout(stdout: str) -> dict | None:
    """Interpret `mmx` stdout for a subcommand that writes a file.

    Returns the reported envelope, or None when stdout is neither a JSON
    object nor a single path that exists on disk.

    Both shapes are accepted on purpose. `--output json` prints one JSON
    object; the CLI's `--quiet` branch prints a bare path instead and ignores
    the requested format. The argv above no longer sends `--quiet`, so the
    JSON shape is what arrives — but a paid, completed generation must never
    again be reported as a failure just because the CLI chose the other
    branch, so the bare-path shape stays understood.

    The path shape is admitted only when the named file actually exists.
    Anything else is genuinely unparseable and must surface as an error
    rather than be guessed at.
    """
    stdout = stdout.strip()
    if not stdout:
        return {}
    try:
        parsed = json.loads(stdout)
    except json.JSONDecodeError:
        parsed = None
    if isinstance(parsed, dict):
        return parsed
    if parsed is not None:
        return None
    lines = [line.strip() for line in stdout.splitlines() if line.strip()]
    if len(lines) == 1 and os.path.exists(lines[0]):
        return {"saved": lines[0]}
    return None


def resolve_mmx_binary() -> str:
    found = shutil.which("mmx")
    if found:
        return found
    here = pathlib.Path(__file__).resolve()
    for parent in here.parents:
        candidate = parent / "node_modules" / ".bin" / "mmx"
        if candidate.is_file():
            return str(candidate)
    print(
        json.dumps(
            {
                "error": (
                    "mmx CLI not found on PATH. Run `npm install` at the "
                    "skillshub workspace root to vendor mmx-cli."
                )
            }
        )
    )
    sys.exit(1)


def main() -> None:
    request = json.load(sys.stdin)
    mmx_config_dir = os.environ.get("MMX_CONFIG_DIR", "").strip()
    if not mmx_config_dir:
        print(
            json.dumps(
                {
                    "error": (
                        "MMX_CONFIG_DIR not set. Runtime must inject the temporary "
                        "MiniMax config directory via config_directory credentials."
                    )
                }
            )
        )
        sys.exit(1)

    prompt = str(request.get("prompt", ""))
    if not prompt:
        print(json.dumps({"error": "prompt is required"}))
        sys.exit(1)

    output_path = normalize_optional_text(str(request.get("output_path", "")))
    if not output_path:
        print(json.dumps({"error": "output_path is required"}))
        sys.exit(1)
    output_path = validate_output_path(output_path)

    lyrics = normalize_optional_text(str(request.get("lyrics", "")))
    instrumental = bool(request.get("instrumental", False))
    lyrics_optimizer = bool(request.get("lyrics_optimizer", False))

    # mmx requires exactly one of these three. Surface a clear error
    # rather than letting the CLI complain.
    mode_count = sum([bool(lyrics), instrumental, lyrics_optimizer])
    if mode_count == 0:
        print(
            json.dumps(
                {
                    "error": (
                        "exactly one of `lyrics`, `instrumental=true`, or "
                        "`lyrics_optimizer=true` must be set"
                    )
                }
            )
        )
        sys.exit(1)
    if mode_count > 1:
        print(
            json.dumps(
                {
                    "error": (
                        "lyrics / instrumental / lyrics_optimizer are mutually "
                        "exclusive — pick exactly one"
                    )
                }
            )
        )
        sys.exit(1)

    vocals = normalize_optional_text(str(request.get("vocals", "")))
    genre = normalize_optional_text(str(request.get("genre", "")))
    mood = normalize_optional_text(str(request.get("mood", "")))
    instruments = normalize_optional_text(str(request.get("instruments", "")))
    tempo = normalize_optional_text(str(request.get("tempo", "")))
    bpm = request.get("bpm")
    musical_key = normalize_optional_text(str(request.get("key", "")))
    structure = normalize_optional_text(str(request.get("structure", "")))
    references = normalize_optional_text(str(request.get("references", "")))
    avoid = normalize_optional_text(str(request.get("avoid", "")))
    use_case = normalize_optional_text(str(request.get("use_case", "")))
    extra = normalize_optional_text(str(request.get("extra", "")))
    model = normalize_optional_text(str(request.get("model", ""))) or "music-2.6"
    audio_format = normalize_optional_text(str(request.get("format", ""))) or "mp3"
    api_timeout_secs = 270

    mmx = resolve_mmx_binary()
    # `MMX_CONFIG_DIR` points at a directory containing config.json, which
    # `mmx` reads under --non-interactive.
    argv: list[str] = [
        mmx,
        "--output",
        "json",
        "--non-interactive",
        "--timeout",
        str(api_timeout_secs),
        "music",
        "generate",
        "--prompt",
        prompt,
        "--out",
        output_path,
        "--model",
        model,
        "--format",
        audio_format,
    ]
    if lyrics:
        argv.extend(["--lyrics", lyrics])
    if instrumental:
        argv.append("--instrumental")
    if lyrics_optimizer:
        argv.append("--lyrics-optimizer")
    for flag, value in (
        ("--vocals", vocals),
        ("--genre", genre),
        ("--mood", mood),
        ("--instruments", instruments),
        ("--tempo", tempo),
        ("--key", musical_key),
        ("--structure", structure),
        ("--references", references),
        ("--avoid", avoid),
        ("--use-case", use_case),
        ("--extra", extra),
    ):
        if value:
            argv.extend([flag, value])
    if bpm is not None:
        argv.extend(["--bpm", str(bpm)])

    mode = (
        "lyrics"
        if lyrics
        else "instrumental"
        if instrumental
        else "lyrics-optimizer"
    )
    log_event(
        f"music_generation started mode={mode} model={model} format={audio_format} "
        f"prompt_len={len(prompt)} api_timeout_secs={api_timeout_secs}"
    )

    started_at = time.perf_counter()
    try:
        completed = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=api_timeout_secs + 30,
        )
    except subprocess.TimeoutExpired:
        print(
            json.dumps(
                {
                    "error": (
                        f"mmx CLI hung past adapter timeout "
                        f"({api_timeout_secs + 30}s)."
                    )
                }
            )
        )
        sys.exit(1)
    except Exception as e:
        print(
            json.dumps(
                {"error": f"Unexpected error spawning mmx: {type(e).__name__}: {e}"}
            )
        )
        sys.exit(1)

    elapsed_ms = round((time.perf_counter() - started_at) * 1000)
    stdout = (completed.stdout or "").strip()
    stderr_tail = "\n".join((completed.stderr or "").strip().splitlines()[-10:])
    log_event(f"mmx returned exit={completed.returncode} elapsed_ms={elapsed_ms}")

    if completed.returncode != 0:
        upstream_error: dict | str = stderr_tail
        try:
            for ln in reversed(
                [ln for ln in (completed.stderr or "").splitlines() if ln.strip()]
            ):
                if ln.startswith("{"):
                    upstream_error = json.loads(ln)
                    break
        except Exception:
            pass
        print(
            json.dumps(
                {
                    "error": f"mmx music generate exit {completed.returncode}.",
                    "upstream": upstream_error,
                    "stdout": stdout[:2000],
                }
            )
        )
        sys.exit(1)

    parsed = parse_mmx_stdout(stdout)
    if parsed is None:
        print(
            json.dumps(
                {
                    "error": (
                        "mmx returned neither a JSON envelope nor the path of a "
                        "written artifact."
                    ),
                    "stdout": stdout[:2000],
                    "stderr_tail": stderr_tail,
                }
            )
        )
        sys.exit(1)

    saved_path = (
        parsed.get("saved")
        or parsed.get("path")
        or parsed.get("file_path")
        or output_path
    )
    # mmx music sometimes reports `saved: [path]` as a list. Normalize.
    if isinstance(saved_path, list):
        saved_path = saved_path[0] if saved_path else output_path

    try:
        size_bytes = os.path.getsize(saved_path)
    except OSError as e:
        print(
            json.dumps(
                {
                    "error": (
                        f"mmx reported completion but the audio file at "
                        f"{saved_path} is unreadable: {e}"
                    ),
                    "upstream": parsed,
                }
            )
        )
        sys.exit(1)

    log_event(f"saved music path={saved_path} size_bytes={size_bytes}")
    result = {
        "prompt": prompt,
        "mode": mode,
        "model": model,
        "format": audio_format,
        "path": saved_path,
        "size_bytes": size_bytes,
        "elapsed_ms": elapsed_ms,
    }
    print(json.dumps(result, indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()
