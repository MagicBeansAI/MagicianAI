<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  @page { size: A4 {{ page_orientation }}; margin: 12mm; }
  * { box-sizing: border-box; }
  body {
    font-family: "Helvetica Neue", "Arial", sans-serif;
    margin: 0;
    padding: 0;
    background: #fff;
    color: #111;
  }
  .header {
    text-align: center;
    border-bottom: 2px solid #111;
    padding: 0 0 6mm 0;
    margin: 0 0 6mm 0;
  }
  .title {
    font-family: "Georgia", serif;
    font-weight: 700;
    font-size: 22pt;
    letter-spacing: 0.5px;
    margin: 0 0 2mm 0;
  }
  .subtitle {
    font-size: 10pt;
    color: #555;
    margin: 0;
  }
  .panel-grid {
    display: grid;
    grid-template-columns: repeat({{ grid_cols }}, 1fr);
    gap: 4mm;
  }
  .panel {
    position: relative;
    border: 3px solid #111;
    overflow: hidden;
    aspect-ratio: {{ panel_aspect_ratio }};
    background: #f4f0e6;
    break-inside: avoid;
  }
  .panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .panel-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.92);
    color: #111;
    padding: 2mm 3mm;
    font-family: "Georgia", serif;
    font-size: 9pt;
    line-height: 1.3;
    border-top: 1px solid #111;
  }
  .footer {
    margin-top: 8mm;
    padding-top: 4mm;
    border-top: 1px solid #ccc;
    text-align: center;
    font-size: 8pt;
    color: #888;
  }
</style>
</head>
<body>
  <div class="header">
    <div class="title">{{ title }}</div>
    <div class="subtitle">{{ subtitle }}</div>
  </div>
  <div class="panel-grid">
  {% for panel in panels %}
    <div class="panel">
      <img src="{{ panel.image_path }}" alt="Panel {{ loop.index }}" />
      {% if panel.caption %}
      <div class="panel-caption">{{ panel.caption }}</div>
      {% endif %}
    </div>
  {% endfor %}
  </div>
  <div class="footer">
    Generated by magician comic-strip skill · style: {{ style_name }} · panels: {{ panels|length }}
  </div>
</body>
</html>
