#!/usr/bin/env python3
"""Bounded Telegram Bot API adapter for the governed tool runtime."""

from __future__ import annotations

import json
import math
import os
import re
import ssl
import sys
import urllib.error
import urllib.request
from typing import Any

MAX_INPUT_BYTES = 1_048_576
MAX_RESPONSE_BYTES = 10_485_760
MAX_JSON_DEPTH = 32
MAX_JSON_NODES = 100_000
METHOD_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_]{0,127}$")
TOKEN_RE = re.compile(r"^[A-Za-z0-9_-]{1,256}:[A-Za-z0-9_-]{1,512}$")

# The explicit send route. `run` hands the adapter a free-form `method` plus an
# opaque `data` blob, so nothing outside this process can tell a send from a
# read or say who a send reaches. This route NAMES the act: the method is fixed
# here and cannot be chosen by the caller, and the recipient arrives as its own
# typed field so the outward gate can screen it before anything leaves.
SEND_ROUTE = "send"
SEND_METHOD = "sendMessage"
SEND_PARAMETERS = frozenset({"chat_id", "text"})
# The two forms a Bot API chat_id may take, and no third. A numeric id (int64,
# negative for groups and supergroups) or an @username. Anything else is
# refused rather than forwarded: a recipient this cannot classify is one the
# gate upstream could not canonicalise either.
CHAT_ID_NUMERIC_RE = re.compile(r"^-?[0-9]{1,19}$")
CHAT_ID_USERNAME_RE = re.compile(r"^@[A-Za-z0-9_]{1,64}$")
# sendMessage rejects a longer body, so refusing here costs one round trip less
# and reports a bound rather than a provider error.
MAX_TEXT_BYTES = 4096


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, file_pointer, code, message, headers, new_url):
        raise urllib.error.HTTPError(
            request.full_url, code, "redirects are disabled", headers, file_pointer
        )


def fail(message: str) -> None:
    print(json.dumps({"ok": False, "error": message}, separators=(",", ":")))
    raise SystemExit(1)


def read_request() -> dict[str, Any]:
    raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
    if not raw or len(raw) > MAX_INPUT_BYTES:
        fail("invalid_request")
    try:
        payload = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError):
        fail("invalid_request")
    if not isinstance(payload, dict):
        fail("invalid_request")
    return payload


def validate_tree(root: Any) -> None:
    stack: list[tuple[Any, int]] = [(root, 1)]
    nodes = 0
    while stack:
        value, depth = stack.pop()
        nodes += 1
        if nodes > MAX_JSON_NODES or depth > MAX_JSON_DEPTH:
            fail("invalid_data")
        if isinstance(value, dict):
            for key, child in value.items():
                if not isinstance(key, str) or len(key.encode("utf-8")) > 4096:
                    fail("invalid_data")
                stack.append((child, depth + 1))
        elif isinstance(value, list):
            for child in value:
                stack.append((child, depth + 1))
        elif isinstance(value, str) and len(value.encode("utf-8")) > MAX_INPUT_BYTES:
            fail("invalid_data")
        elif isinstance(value, float) and not math.isfinite(value):
            fail("invalid_data")
        elif value is not None and not isinstance(value, (str, int, float, bool)):
            fail("invalid_data")


def bounded_response(response) -> bytes:
    body = response.read(MAX_RESPONSE_BYTES + 1)
    if len(body) > MAX_RESPONSE_BYTES:
        fail("provider_response_too_large")
    return body


def typed_send(payload: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    """Build a sendMessage call from a typed recipient and body.

    The closed argument surface of the send route. `method` is NOT read from the
    payload: it is fixed to sendMessage here, so this route cannot be steered
    into getUpdates or a member list by whoever composed the call. An unknown
    key is refused rather than dropped, because a parameter that vanished
    silently gives the caller a send it did not compose.
    """
    if set(payload) - SEND_PARAMETERS:
        fail("unexpected_send_parameter")
    chat_id = payload.get("chat_id")
    text = payload.get("text")
    if not isinstance(chat_id, str) or not isinstance(text, str):
        fail("invalid_send_request")
    chat_id = chat_id.strip()
    if CHAT_ID_NUMERIC_RE.fullmatch(chat_id):
        # Sent as an integer, which is the form every live call through the
        # `run` route has always used. A recipient whose form we changed is a
        # recipient we cannot claim the gate screened.
        recipient: Any = int(chat_id)
    elif CHAT_ID_USERNAME_RE.fullmatch(chat_id):
        recipient = chat_id
    else:
        fail("invalid_chat_id")
    if not text.strip():
        fail("invalid_text")
    if len(text.encode("utf-8")) > MAX_TEXT_BYTES:
        fail("text_too_large")
    return SEND_METHOD, {"chat_id": recipient, "text": text}


def write_send_receipt(result: dict[str, Any], recipient: Any) -> None:
    """Name the provider message this send became, at the TOP level.

    The Bot API buries it at `result.message_id`, one level below anything a
    receipt reader keyed on a top-level field can see, so the id existed and was
    unreachable. This lifts it and keeps the provider's own `result` beside it,
    so nothing is lost by the lift.

    An id that is not there is left ABSENT. Never invented and never defaulted:
    an unreconcilable send is a failure to KNOW which message it became, and a
    fabricated id would bind a real complaint to the wrong act.
    """
    message = result.get("result")
    receipt: dict[str, Any] = {"ok": True, "method": SEND_METHOD, "chat_id": recipient}
    message_id = message.get("message_id") if isinstance(message, dict) else None
    if isinstance(message_id, int) and not isinstance(message_id, bool):
        receipt["message_id"] = message_id
    receipt["result"] = message if isinstance(message, dict) else None
    encoded = json.dumps(receipt, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
    sys.stdout.buffer.write(encoded)
    sys.stdout.buffer.write(b"\n")


def main() -> None:
    # One argument selects the route, and only one value is accepted. An
    # unrecognised token is refused rather than falling back to `run`: a routing
    # word nobody implemented must not silently become the ungated path.
    route = sys.argv[1] if len(sys.argv) > 1 else None
    if route is not None and route != SEND_ROUTE:
        fail("unknown_route")

    payload = read_request()
    if route == SEND_ROUTE:
        method, data = typed_send(payload)
    else:
        method = payload.get("method")
        data_source = payload.get("data", "{}")
        if not isinstance(method, str) or not METHOD_RE.fullmatch(method):
            fail("invalid_method")
        if not isinstance(data_source, str) or len(data_source.encode("utf-8")) > MAX_INPUT_BYTES:
            fail("invalid_data")
        try:
            data = json.loads(data_source)
        except (json.JSONDecodeError, RecursionError):
            fail("invalid_data")
        if not isinstance(data, dict):
            fail("invalid_data")
    validate_tree(data)

    token = os.environ.get("TELEGRAM_TOKEN", "")
    if not TOKEN_RE.fullmatch(token):
        fail("credential_unavailable")
    request = urllib.request.Request(
        f"https://api.telegram.org/bot{token}/{method}",
        data=json.dumps(data, separators=(",", ":"), ensure_ascii=False).encode("utf-8"),
        headers={"Content-Type": "application/json", "Accept": "application/json"},
        method="POST",
    )
    opener = urllib.request.build_opener(
        NoRedirect(), urllib.request.HTTPSHandler(context=ssl.create_default_context())
    )
    try:
        with opener.open(request, timeout=12) as response:
            body = bounded_response(response)
    except urllib.error.HTTPError as error:
        body = error.read(MAX_RESPONSE_BYTES + 1)
        if len(body) <= MAX_RESPONSE_BYTES:
            sys.stdout.buffer.write(body)
            if not body.endswith(b"\n"):
                sys.stdout.buffer.write(b"\n")
        raise SystemExit(1)
    except (urllib.error.URLError, TimeoutError, OSError):
        fail("provider_unavailable")

    try:
        result = json.loads(body)
    except (json.JSONDecodeError, RecursionError):
        fail("invalid_provider_response")
    validate_tree(result)
    accepted = isinstance(result, dict) and result.get("ok") is True
    if route == SEND_ROUTE and accepted:
        write_send_receipt(result, data["chat_id"])
        return
    # Everything else — the whole `run` route, and a send the provider refused —
    # is echoed verbatim. A refused send must show the provider's own reason, not
    # a receipt shape that would read as a message that exists.
    sys.stdout.buffer.write(body)
    if not body.endswith(b"\n"):
        sys.stdout.buffer.write(b"\n")
    if not accepted:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
