#!/usr/bin/env python3
"""Bounded KLIPY GIF-search adapter for the governed skill runtime."""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from typing import Any, Callable
from types import SimpleNamespace


KLIPY_API_ORIGIN = "https://api.klipy.com"
MAX_RESPONSE_BYTES = 10 * 1024 * 1024
MAX_QUERY_CHARS = 4_096
MAX_API_KEY_CHARS = 4_096
MAX_RESULTS = 20
MAX_INSPECTED_ITEMS = 200
MAX_TITLE_CHARS = 4_096
MAX_SLUG_CHARS = 1_024
MAX_URL_CHARS = 8_192
MAX_INPUT_BYTES = 65_536
CONTENT_FILTERS = ("off", "pg", "pg-13", "r")
UrlOpen = Callable[..., Any]

# --- Governed timeout budget -------------------------------------------------
# INVARIANT:
#   GOVERNED_KILL_CEILING_SECS >= INNER_WORST_CASE_SECS + GOVERNED_KILL_MARGIN_SECS
#
# `perform_search` issues exactly one KLIPY call, so the adapter's own deadline
# budget is:
#
#   INNER_WORST_CASE_SECS = PROVIDER_TIMEOUT_SECS = 15
#
# GOVERNED_KILL_CEILING_SECS mirrors `runtime.limits.timeout_secs` in this
# skill's SKILL.md, which is the runtime's wall-clock kill. That kill is a
# backstop for a process that has stopped responding, not the primary provider
# deadline: if it fires first, this adapter's own timeout handling becomes
# unreachable code. It must stay above the budget above by at least
# GOVERNED_KILL_MARGIN_SECS, which covers interpreter start, stdin read, and
# response normalization. This skill already satisfied the invariant; the
# constants below record the arithmetic that was previously implicit.
#
# The manifest is YAML this adapter must not read at execution time, so the
# ceiling is mirrored here. Both sides are pinned together by
# `tests/test_klipy_gif_search.py::test_governed_kill_outlasts_the_inner_provider_budget`
# and by `tool-runtime-core/tests/phase7_migration.rs::
# credentialed_adapter_governed_kill_outlasts_its_inner_provider_budget`.
#
# Adding a request or raising PROVIDER_TIMEOUT_SECS REQUIRES raising
# `runtime.limits.timeout_secs` in SKILL.md by the same amount. Note the socket
# deadline is per operation, not a total wall clock, so INNER_WORST_CASE_SECS is
# a lower bound on true elapsed time; the governed kill remains the only total
# bound, which is why it must be the outer one.
PROVIDER_TIMEOUT_SECS = 15
INNER_WORST_CASE_SECS = 15
GOVERNED_KILL_MARGIN_SECS = 5
GOVERNED_KILL_CEILING_SECS = 20


class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Keep the path credential on the declared KLIPY origin."""

    def redirect_request(self, *_args: Any, **_kwargs: Any) -> None:
        return None


def open_without_redirects(request: urllib.request.Request, timeout: int) -> Any:
    return urllib.request.build_opener(NoRedirectHandler()).open(request, timeout=timeout)


def parse_input(raw: bytes) -> SimpleNamespace:
    if not raw or len(raw) > MAX_INPUT_BYTES:
        raise ValueError("invalid governed input envelope")
    value = json.loads(raw)
    if not isinstance(value, dict):
        raise ValueError("invalid governed input envelope")
    value["limit"] = int(value["limit"])
    if not 1 <= value["limit"] <= MAX_RESULTS:
        raise ValueError("invalid provider result limit")
    return SimpleNamespace(**value)


def validate_api_key(value: str) -> str:
    if not value or len(value) > MAX_API_KEY_CHARS:
        raise ValueError("KLIPY credential is unavailable")
    if any(ord(character) < 0x20 or ord(character) == 0x7F for character in value):
        raise ValueError("KLIPY credential is invalid")
    return value


def build_request(api_key: str, args: SimpleNamespace) -> urllib.request.Request:
    credential = urllib.parse.quote(validate_api_key(api_key), safe="")
    query = urllib.parse.urlencode(
        {
            "q": args.query,
            "per_page": args.limit,
            "page": 1,
            "content_filter": args.content_filter,
            "locale": "en",
        }
    )
    url = f"{KLIPY_API_ORIGIN}/api/v1/{credential}/gifs/search?{query}"
    return urllib.request.Request(
        url,
        headers={
            "Accept": "application/json",
            "User-Agent": "uuaa-skill-runtime/1.0",
        },
        method="GET",
    )


def bounded_text(value: Any, limit: int) -> str:
    return value[:limit] if isinstance(value, str) else ""


def safe_url(value: Any) -> str:
    if (
        not isinstance(value, str)
        or not value
        or len(value) > MAX_URL_CHARS
        or any(ord(character) < 0x20 or ord(character) == 0x7F for character in value)
    ):
        return ""
    try:
        parsed = urllib.parse.urlsplit(value)
        hostname = parsed.hostname
        _ = parsed.port
    except ValueError:
        return ""
    if (
        parsed.scheme not in ("http", "https")
        or not hostname
        or parsed.username
        or parsed.password
    ):
        return ""
    return value


def rendition_url(file_info: dict[str, Any], kind: str) -> str:
    for tier in ("hd", "md", "sd"):
        tier_data = file_info.get(tier)
        if not isinstance(tier_data, dict):
            continue
        rendition = tier_data.get(kind)
        candidate = rendition.get("url") if isinstance(rendition, dict) else rendition
        url = safe_url(candidate)
        if url:
            return url
    return ""


def normalize_response(
    response: dict[str, Any], query: str, limit: int
) -> dict[str, Any]:
    if response.get("error") is not None:
        raise ValueError("KLIPY returned a provider error")
    raw_data = response.get("data")
    if isinstance(raw_data, dict):
        items = raw_data.get("data")
    elif isinstance(raw_data, list):
        items = raw_data
    else:
        items = []
    if not isinstance(items, list):
        items = []

    gifs: list[dict[str, str]] = []
    for inspected, item in enumerate(items):
        if inspected >= MAX_INSPECTED_ITEMS:
            break
        if len(gifs) >= limit:
            break
        if not isinstance(item, dict):
            continue
        file_info = item.get("file")
        if not isinstance(file_info, dict):
            file_info = {}
        gif_url = rendition_url(file_info, "gif") or safe_url(item.get("url"))
        if not gif_url:
            continue
        preview_url = rendition_url(file_info, "webp") or gif_url
        gifs.append(
            {
                "url": gif_url,
                "title": bounded_text(item.get("title"), MAX_TITLE_CHARS),
                "slug": bounded_text(item.get("slug"), MAX_SLUG_CHARS),
                "preview": preview_url,
            }
        )

    output: dict[str, Any] = {
        "query": query,
        "count": len(gifs),
        "gifs": gifs,
    }
    if not gifs:
        output["warning"] = "KLIPY returned no safe GIF results."
    return output


def perform_search(
    api_key: str,
    args: SimpleNamespace,
    *,
    opener: UrlOpen = open_without_redirects,
) -> dict[str, Any]:
    request = build_request(api_key, args)
    with opener(request, timeout=PROVIDER_TIMEOUT_SECS) as response:
        raw = response.read(MAX_RESPONSE_BYTES + 1)
    if len(raw) > MAX_RESPONSE_BYTES:
        raise ValueError("KLIPY response exceeded the configured size limit")
    decoded = json.loads(raw)
    if not isinstance(decoded, dict):
        raise ValueError("KLIPY returned a non-object response")
    return normalize_response(decoded, args.query, args.limit)


def main(input_bytes: bytes | None = None) -> int:
    api_key = os.environ.get("KLIPY_API_KEY", "")
    if not api_key:
        print(json.dumps({"error": "KLIPY_API_KEY not set"}), file=sys.stderr)
        return 2
    try:
        args = parse_input(input_bytes if input_bytes is not None else sys.stdin.buffer.read(MAX_INPUT_BYTES + 1))
        output = perform_search(api_key, args)
    except (
        urllib.error.URLError,
        TimeoutError,
        ValueError,
        TypeError,
        AttributeError,
        json.JSONDecodeError,
        RecursionError,
    ) as error:
        print(json.dumps({"error": type(error).__name__}), file=sys.stderr)
        return 1
    print(json.dumps(output, indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
