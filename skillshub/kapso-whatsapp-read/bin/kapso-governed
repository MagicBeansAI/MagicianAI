#!/usr/bin/env bash
# Kapso WhatsApp identity adapter (shared shape by kapso-whatsapp-read and
# kapso-whatsapp-send; each skill keeps its own copy so the runtime can
# preserve one fixed sending/reading identity policy).
#
# Auth: the kapso CLI reads KAPSO_API_KEY directly from the environment
# (project-scoped — "no browser"). The operator key is delivered to this
# subprocess as KAPSO_API_KEY (declared in this skill's config/.env.example,
# populated from operator-config.yaml by `make -C skillshub setup-env`, and
# injected by the universal runtime). No rename needed: the
# operator-config key name already matches what the CLI expects.
#
# --phone-number-id injection: the kapso CLI is project-scoped, so most
# reads work without a number. But the per-number subcommands REQUIRE one
# and do NOT honor any env default — they error with "A WhatsApp number is
# required" unless `--phone-number-id`/`--phone-number` is passed. We inject
# `--phone-number-id "$KAPSO_PHONE_NUMBER_ID"` (Presto's own number) ONLY for
# the subcommands that benefit (messages list/send REQUIRE a number;
# conversations list is scoped to Presto's number). Caller-supplied number
# selectors are rejected so an escape-hatch argv cannot replace this skill's
# fixed identity. We deliberately do NOT inject for:
#   - by-id lookups (`messages get`, `conversations get`) — the id is enough;
#   - `numbers resolve` / `numbers list` — these intentionally operate on an
#     arbitrary/whole-project number set, so scoping them to Presto's number
#     would corrupt intent (and `numbers list` rejects the flag outright:
#     "Nonexistent flag: --phone-number-id").
# The allowlist is therefore exact.
#
# --output json: JSON is already the CLI default for every subcommand; we
# inject it explicitly when absent so output is machine-readable regardless
# of any future default change.
set -euo pipefail
: "${KAPSO_API_KEY:?KAPSO_API_KEY not set — run: make -C skillshub setup-env}"
export KAPSO_API_KEY

# Subcommand pairs ("topic action") for which we scope to Presto's own number.
# Exact allowlist — everything else (by-id gets, numbers list/resolve) is left
# untouched so it either does not need a number or operates project-wide.
pnid_accepting() {
  case "$1 $2" in
    "messages list" | "messages send" | "conversations list")
      return 0 ;;
    *) return 1 ;;
  esac
}

# Reject caller-controlled identity selectors and detect output formatting.
has_output_flag=false
for a in "$@"; do
  case "$a" in
    --phone-number-id | --phone-number-id=* | --phone-number | --phone-number=*)
      echo "kapso-whatsapp-read: caller-supplied sender identity is forbidden" >&2
      exit 64 ;;
    --output | --output=*)
      has_output_flag=true ;;
  esac
done

# Args after the literal `whatsapp` are: <topic> <action> ...
# argv layout from the tool_schema: whatsapp <topic> <action> [flags...]
topic="${1:-}"; sub="${2:-}"; action="${3:-}"
inject=()
if [ "$topic" = "whatsapp" ]; then
  if pnid_accepting "$sub" "$action"; then
    if [ -n "${KAPSO_PHONE_NUMBER_ID:-}" ]; then
      inject+=(--phone-number-id "$KAPSO_PHONE_NUMBER_ID")
    fi
  fi
fi
if [ "$has_output_flag" = false ]; then
  inject+=(--output json)
fi

# Expand the injected-args array safely even when empty (set -u would treat
# "${inject[@]}" on an empty array as an unbound variable on bash < 4.4).
exec kapso "$@" ${inject[@]+"${inject[@]}"}
