#!/usr/bin/env python3
"""Bounded OpenAI Images API client/artifact normalizer for governed skills."""
from __future__ import annotations

import base64
import hashlib
import http.client
import io
import json
import os
from pathlib import Path
import re
import stat
import sys
import urllib.error
import urllib.request
import uuid

from PIL import Image


API_ORIGIN = "https://api.openai.com/v1/images/"
# GPT Image 2.5 ships two variants at the same token rates. OpenAI recommends
# Sunburst where editing precision matters and Flare for everyday generation,
# so each action defaults to its recommended variant; callers may pick either.
MODELS = {"gpt-image-2.5-flare", "gpt-image-2.5-flare-2026-09-08",
          "gpt-image-2.5-sunburst", "gpt-image-2.5-sunburst-2026-09-08"}
DEFAULT_MODELS = {"generate": "gpt-image-2.5-flare", "edit": "gpt-image-2.5-sunburst"}
QUALITIES = {"auto", "low", "medium", "high", "xhigh", "max"}
PRICING_VERSION = "openai-standard-2026-10-17-gpt-image-2.5"
# USD / million tokens equals integer micro-USD / token. Direct Images API
# inputs have no cached discount. Keep this tariff separate from model input.
TOKEN_RATES = {"text_input": 5, "image_input": 8, "image_output": 30}
PROVIDER_TIMEOUT_SECS = 300
MAX_INPUT_BYTES = 262144
MAX_RESPONSE_BYTES = 48 * 1024 * 1024
MAX_IMAGE_BYTES = 50 * 1024 * 1024
MAX_MASK_BYTES = 4 * 1024 * 1024
MAX_OUTPUT_BYTES = 32 * 1024 * 1024
FORMATS = {"png": ("PNG", "image/png", {".png"}),
           "jpeg": ("JPEG", "image/jpeg", {".jpg", ".jpeg"}),
           "webp": ("WEBP", "image/webp", {".webp"})}


class NoRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *_args, **_kwargs):
        return None


def open_provider(request, timeout):
    return urllib.request.build_opener(NoRedirects()).open(request, timeout=timeout)


def parse_input(action, raw):
    if action not in {"generate", "edit"} or not raw or len(raw) > MAX_INPUT_BYTES:
        raise ValueError("Invalid action or input envelope")
    args = json.loads(raw)
    allowed = {"prompt", "output_path", "model", "quality", "size", "output_format", "background"}
    if action == "edit":
        allowed |= {"image_path", "mask_path"}
    if not isinstance(args, dict) or args.keys() - allowed:
        raise ValueError("Unknown image parameter")
    for key in ("prompt", "output_path") + (("image_path",) if action == "edit" else ()):
        limit = 32000 if key == "prompt" else 4096
        if not isinstance(args.get(key), str) or not args[key].strip() or len(args[key]) > limit:
            raise ValueError("Missing or invalid image parameter")
    for key, default, options in [
        ("model", DEFAULT_MODELS[action], MODELS), ("quality", "auto", QUALITIES),
        ("output_format", "png", FORMATS), ("background", "auto", {"auto", "opaque", "transparent"}),
    ]:
        args.setdefault(key, default)
        if not isinstance(args[key], str) or args[key] not in options:
            raise ValueError("Unsupported image option")
    args.setdefault("size", "auto")
    if args["size"] != "auto":
        match = re.fullmatch(r"([1-9][0-9]{0,3})x([1-9][0-9]{0,3})", str(args["size"]))
        if not match:
            raise ValueError("Invalid image size")
        width, height = map(int, match.groups())
        if (width % 16 or height % 16 or max(width, height) > 3840
                or max(width, height) > 3 * min(width, height)
                or not 655360 <= width * height <= 8294400):
            raise ValueError("Image size exceeds GPT Image 2.5 limits")
    if args["background"] == "transparent" and args["output_format"] == "jpeg":
        raise ValueError("Transparent images require PNG or WebP")
    if Path(args["output_path"]).suffix.lower() not in FORMATS[args["output_format"]][2]:
        raise ValueError("Output extension must match output_format")
    if "mask_path" in args and (not isinstance(args["mask_path"], str)
                                or not args["mask_path"].strip() or len(args["mask_path"]) > 4096):
        raise ValueError("Invalid mask path")
    return args


def open_parent(raw_path):
    """Bind file access to the invocation cwd without following symlink parents."""
    root = Path.cwd().resolve()
    path = Path(raw_path)
    try:
        relative = path.relative_to(root) if path.is_absolute() else path
    except ValueError:
        raise ValueError("Image paths must stay in the governed workspace") from None
    if not relative.parts or any(part == ".." for part in relative.parts):
        raise ValueError("Image paths must stay in the governed workspace")
    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in relative.parts[:-1]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = child
        return fd, relative.name, root / relative
    except BaseException:
        os.close(fd)
        raise


def read_image(raw_path, maximum, mask=False):
    parent, name, _ = open_parent(raw_path)
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
        with os.fdopen(fd, "rb") as file:
            info = os.fstat(file.fileno())
            if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size < maximum:
                raise ValueError("Image must be a bounded regular file")
            data = file.read(maximum)
    finally:
        os.close(parent)
    if not data or len(data) >= maximum:
        raise ValueError("Image exceeds its byte limit")
    with Image.open(io.BytesIO(data)) as image:
        fmt, dimensions = image.format, image.size
        if fmt not in {"PNG", "JPEG", "WEBP"} or (mask and fmt != "PNG"):
            raise ValueError("Unsupported input image format")
        if mask and "A" not in image.getbands() and "transparency" not in image.info:
            raise ValueError("A mask requires PNG transparency")
        image.verify()
    mime = next(value[1] for value in FORMATS.values() if value[0] == fmt)
    return data, mime, dimensions


def multipart(fields, files):
    boundary = "magician-" + uuid.uuid4().hex
    chunks = []
    for name, value in fields.items():
        chunks.append((f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"\r\n\r\n'
                       f'{value}\r\n').encode())
    for name, data, mime in files:
        # The filename is provider metadata, never caller-controlled header text.
        extension = mime.split("/")[1]
        chunks.extend([(f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"; '
                        f'filename="input.{extension}"\r\nContent-Type: {mime}\r\n\r\n').encode(),
                       data, b"\r\n"])
    chunks.append(f"--{boundary}--\r\n".encode())
    return b"".join(chunks), "multipart/form-data; boundary=" + boundary


def accounting(value):
    """Retain valid usage; price only a complete, consistent GPT Image 2.5 receipt."""
    usage = {}
    if not isinstance(value, dict):
        return usage, None
    def count(v):
        return isinstance(v, int) and not isinstance(v, bool) and 0 <= v <= 2**63 - 1
    for key in ("input_tokens", "output_tokens", "total_tokens"):
        if count(value.get(key)):
            usage[key] = value[key]
    for key in ("input_tokens_details", "output_tokens_details"):
        if isinstance(value.get(key), dict):
            usage[key] = {name: value[key][name] for name in ("text_tokens", "image_tokens")
                          if count(value[key].get(name))}
    details = usage.get("input_tokens_details", {})
    if (not {"input_tokens", "output_tokens", "total_tokens", "input_tokens_details"} <= usage.keys()
            or not {"text_tokens", "image_tokens"} <= details.keys()
            or details["text_tokens"] + details["image_tokens"] != usage.get("input_tokens")
            or usage.get("input_tokens", -1) + usage.get("output_tokens", -1) != usage.get("total_tokens")):
        return usage, None
    output = usage.get("output_tokens_details")
    if output is not None and (output.get("image_tokens") != usage["output_tokens"]
                               or output.get("text_tokens", 0) != 0):
        return usage, None
    cost = (details["text_tokens"] * TOKEN_RATES["text_input"]
            + details["image_tokens"] * TOKEN_RATES["image_input"]
            + usage["output_tokens"] * TOKEN_RATES["image_output"])
    return usage, cost if cost < 2**64 else None


def request_id(headers):
    value = headers.get("x-request-id", "")
    return value if isinstance(value, str) and re.fullmatch(r"[A-Za-z0-9_-]{1,1024}", value) else None


def perform(action, args, api_key, opener=open_provider):
    parent, filename, output_path = open_parent(args["output_path"])
    try:
        try:
            os.stat(filename, dir_fd=parent, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            raise ValueError("Choose a new output file; existing files are never overwritten")
        if not os.access(".", os.W_OK, dir_fd=parent):
            raise ValueError("Output directory is not writable")
        fields = {key: args[key] for key in ("model", "prompt", "quality", "size", "output_format", "background")}
        fields["n"] = 1
        if action == "generate":
            body, content_type = json.dumps(fields).encode(), "application/json"
        else:
            source, mime, dimensions = read_image(args["image_path"], MAX_IMAGE_BYTES)
            files = [("image[]", source, mime)]
            if args.get("mask_path"):
                mask, mask_mime, mask_dimensions = read_image(args["mask_path"], MAX_MASK_BYTES, mask=True)
                if mask_dimensions != dimensions:
                    raise ValueError("Mask dimensions must match the source image")
                files.append(("mask", mask, mask_mime))
            body, content_type = multipart(fields, files)
        request = urllib.request.Request(API_ORIGIN + ("generations" if action == "generate" else "edits"),
                                         data=body, headers={"Authorization": "Bearer " + api_key,
                                                             "Content-Type": content_type}, method="POST")
        with opener(request, timeout=PROVIDER_TIMEOUT_SECS) as response:
            receipt_id = request_id(response.headers)
            result = {"provider": "openai", "model": args["model"], "action": action,
                      "request_id": receipt_id, "usage": {}, "cost_microusd": None,
                      "pricing_version": PRICING_VERSION,
                      "cost_status": "unavailable", "images": []}
            try:
                raw = response.read(MAX_RESPONSE_BYTES + 1)
                if len(raw) > MAX_RESPONSE_BYTES:
                    raise ValueError("OpenAI image response exceeds its byte limit")
                payload = json.loads(raw)
                if not isinstance(payload, dict) or payload.get("error"):
                    raise ValueError("OpenAI returned an invalid image response")
            except (ValueError, OSError, http.client.HTTPException):
                # A header receipt is still useful when the body is truncated,
                # malformed or oversized. Its charge remains unknown.
                result["artifact_error"] = "Provider response could not be read or validated; outcome and cost unknown; do not repeat automatically"
                return result
        usage, cost = accounting(payload.get("usage"))
        result.update(usage=usage, cost_microusd=cost,
                      cost_status="estimated" if cost is not None else "unavailable")
        try:
            items = payload.get("data")
            if not isinstance(items, list) or len(items) != 1 or not isinstance(items[0], dict):
                raise ValueError("Expected one generated image")
            encoded = items[0].get("b64_json")
            if not isinstance(encoded, str) or len(encoded) > 4 * ((MAX_OUTPUT_BYTES + 2) // 3):
                raise ValueError("Invalid or oversized generated image")
            data = base64.b64decode(encoded, validate=True)
            if not data or len(data) > MAX_OUTPUT_BYTES:
                raise ValueError("Invalid or oversized generated image")
            with Image.open(io.BytesIO(data)) as image:
                if image.format != FORMATS[args["output_format"]][0]:
                    raise ValueError("Generated image format differs from requested format")
                width, height = image.size
                image.verify()
            fd = os.open(filename, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=parent)
            with os.fdopen(fd, "wb") as file:
                file.write(data)
                file.flush()
                os.fsync(file.fileno())
            result["images"] = [{"path": str(output_path), "size_bytes": len(data),
                                 "media_type": FORMATS[args["output_format"]][1], "width": width,
                                 "height": height, "sha256": hashlib.sha256(data).hexdigest()}]
        except (ValueError, OSError, SyntaxError, Image.DecompressionBombError):
            # This provider call already completed. Keep billing evidence even
            # when no usable artifact can be produced; Work seals the failure.
            result["artifact_error"] = "Provider completed, but its image could not be decoded or saved; do not repeat automatically"
        return result
    finally:
        os.close(parent)


def main():
    try:
        if len(sys.argv) != 2:
            raise ValueError("Use the governed generate or edit action")
        args = parse_input(sys.argv[1], sys.stdin.buffer.read(MAX_INPUT_BYTES + 1))
        key = os.environ.get("OPENAI_API_KEY", "").strip()
        if not key:
            raise ValueError("OPENAI_API_KEY must be injected by scoped credential authority")
        result = perform(sys.argv[1], args, key)
    except urllib.error.HTTPError as error:
        result = {"error": "OpenAI image request failed", "http_status": error.code,
                  "request_id": request_id(error.headers)}
        error.close()
    except (ValueError, OSError, SyntaxError, http.client.HTTPException, Image.DecompressionBombError):
        # Never echo provider bodies, request prompts or credential material.
        result = {"error": "Image request failed validation or transport; no automatic retry"}
    print(json.dumps(result, separators=(",", ":")))
    return 1 if "error" in result else 0


if __name__ == "__main__":
    raise SystemExit(main())
