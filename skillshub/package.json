{
  "name": "@magician/skillshub",
  "private": true,
  "type": "module",
  "description": "npm workspace root for skillshub. Hoists deps for skills that share a runtime (TinyFish, rg, dugite, all bot daemons). Browser is intentionally NOT a workspace — it owns its own node_modules so the patched-binary overlay survives root-level reinstalls.",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "rg",
    "dugite",
    "image-generation-via-minimax",
    "video-generation-via-minimax",
    "music-generation-via-minimax",
    "analyze-image-via-minimax",
    "web-search-via-minimax",
    "bots",
    "bots/sdk",
    "bots/telegram",
    "bots/telegram-self",
    "bots/whatsapp",
    "bots/kapso",
    "bots/gmail",
    "bots/agentmail"
  ],
  "scripts": {
    "build": "npm run build -w @magician/bots",
    "check": "npm run check -w @magician/bots",
    "test": "npm run test -w @magician/bots"
  },
  "dependencies": {
    "@kapso/cli": "0.17.1",
    "@tiny-fish/cli": "0.33.0",
    "agentmail-cli": "^0.7.12",
    "mcp-remote": "^0.1.38"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "agentmail-cli@0.7.12": true,
    "better-sqlite3@12.9.0": true,
    "dugite@3.2.2": true,
    "esbuild@0.24.2": true,
    "esbuild@0.28.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.5.6": true,
    "protobufjs@6.8.8": true,
    "sharp@0.34.5": true,
    "@googleworkspace/cli@0.16.0": true,
    "@whiskeysockets/baileys@7.0.0-rc10": true,
    "svix": false
  }
}
