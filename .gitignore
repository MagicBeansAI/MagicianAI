# Skillshub root npm workspace — populated by `make setup-skillshub-deps`.
# rg, dugite, and the bot daemons share this. Browser is intentionally
# NOT a workspace member (its node_modules holds the patched-binary
# overlay).
skillshub/node_modules/

# Per-skill npm node_modules — only the browser skill keeps its own
# (for the patched-binary overlay; `make setup-agent-browser`).
# package-lock.json IS committed at all levels for reproducibility.
skillshub/*/node_modules/

# Compiled TypeScript output for the bot daemons — regenerated by
# `make setup-bots`. Source under skillshub/bots/<bot>/src/ stays in git.
skillshub/bots/*/dist/

# Skillshub-root Python venv — `make setup-skillshub-python` creates +
# populates from the aggregated requirements.txt. Regenerable; never
# committed. requirements.txt IS committed (generated artifact pinned
# into git so reviewers see what gets installed).
skillshub/.venv/

# Project-pinned Node 22 LTS unpacked by `make -C skillshub setup-node`.
# Tarball comes from nodejs.org and is platform/arch-specific; the
# pinned version is in `skillshub/.node-version` (committed).
skillshub/.node/

# Per-skill dedicated Python venvs — only `marimo` uses this today
# (heavy data-science deps that don't belong in the shared venv).
# Created by `make -C skillshub setup-marimo`. Regenerable.
skillshub/*/.venv/

# Metabase printing-press build artifacts — regenerated by
# `make -C skillshub regen-metabase-cli`. The output binary is at
# `skillshub/metabase/bin/metabase-pp-cli` (covered by the
# `skillshub/*/bin/` rule above).
skillshub/metabase/.pp-build/

# Test-runtime checkpoint files (regenerated by tests, causes noisy diffs)
magician/test-runtime/threads/*/checkpoints/

# Service binaries (root directory). The build targets stage every
# executable here next to each other so there's a single canonical
# place to read from — avoids the "we built one binary, but the run
# target picked up a stale copy from somewhere else" footgun.
/magician.bin
/magic-supervisor.bin
/magicutor.bin
/decision-engine.bin
/magician-desktop.bin
/magician-macos-presence-host.bin
/magician-macos-meet-audio.bin
/magician-macos-audio-engine.bin

# Service binaries in target directories
target/release/magician
target/debug/magician
target/release/magic-supervisor
target/debug/magic-supervisor
target/release/magicutor
target/debug/magicutor

