# Public UI env vars. Copy to .env / .env.development; never put secrets here.

# Optional Microsoft Clarity tracking project ID, visible to website visitors.
# Unset by default: self-hosted deployments send no Clarity recordings.
# This is NOT a Clarity Data Export API token. Never put that token in public env.
PUBLIC_CLARITY_PROJECT_ID=

# Resource Authority API key (resource-authority client).
VITE_RESOURCE_AUTHORITY_API_KEY=

# Tutor draw-overlay: render primitives via the data-driven recipe interpreter
# (shared recipe set from GET /api/magician/v2/tutor/primitives). Default ON when
# unset; set to false to force the legacy native SVG renderer.
# See docs/components/magician/tutor-primitive-recipes.md
VITE_USE_RECIPE_INTERPRETER=true

# Build context only; make build-marketing-site sets this for crawlable public
# HTML. Leave unset for personal-app artifacts and normal Vite development.
# VITE_MARKETING_BUILD=true
