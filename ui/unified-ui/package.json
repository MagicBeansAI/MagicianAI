{
  "name": "unified-ui",
  "private": true,
  "version": "0.1.31",
  "packageManager": "npm@10.9.3",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --diagnostic-sources js,svelte --compiler-warnings \"a11y_click_events_have_key_events:ignore,a11y_no_static_element_interactions:ignore,a11y_label_has_associated_control:ignore,css_unused_selector:ignore,a11y_no_noninteractive_element_interactions:ignore\"",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --diagnostic-sources js,svelte --compiler-warnings \"a11y_click_events_have_key_events:ignore,a11y_no_static_element_interactions:ignore,a11y_label_has_associated_control:ignore,css_unused_selector:ignore,a11y_no_noninteractive_element_interactions:ignore\" --watch",
    "check:all": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:strict": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --diagnostic-sources js,svelte",
    "test": "vitest run",
    "test:report": "vitest run --config vitest.report.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^25.0.3",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/three": "^0.169.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "svelte": "^5.56.8",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@types/d3": "^7.4.3",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "bits-ui": "^2.18.1",
    "cronstrue": "^3.13.0",
    "d3": "^7.9.0",
    "daisyui": "^5.1.9",
    "diff": "^9.0.0",
    "lottie-web": "^5.13.0",
    "shiki": "^4.0.2",
    "swagger-ui-dist": "^5.32.0",
    "three": "^0.169.0",
    "vosk-browser": "^0.0.8",
    "yuka": "^0.7.8"
  },
  "overrides": {
    "browserslist": "4.28.9",
    "cookie": "0.7.2",
    "nanoid": "3.3.18",
    "postcss-selector-parser": "6.1.3",
    "sucrase": "3.35.1",
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  },
  "scarfSettings": {
    "enabled": false
  }
}
