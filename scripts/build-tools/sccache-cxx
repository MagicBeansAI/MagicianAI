#!/usr/bin/env python3
"""Cache native compilation without changing Rust's incremental environment."""
import os
from pathlib import Path
import sys

cache = os.environ.get("SCCACHE", "")
if not cache or Path(cache).resolve() == Path(__file__).resolve():
    raise SystemExit("sccache-cxx: SCCACHE must name the real sccache executable")
os.environ.pop("CARGO_INCREMENTAL", None)
os.execv(cache, [cache, *sys.argv[1:]])
