<resources>
    <string name="magican_glance_widget_description">See what needs you and what is active, or start talking.</string>

    <string name="setup_title">Setup Instructions</string>
    <string name="setup_step_1">1. Enable AccessibilityService in Settings → Accessibility → Magdroid</string>
    <string name="setup_step_2">2. Grant "Allow restricted settings" permission in Settings → Apps → Magdroid → Advanced</string>
    <string name="setup_step_3">3. Enable Notification access in Settings → Notifications → Notification access → Magdroid</string>
<string name="setup_step_5">5. Pair this device with your Magician</string>

    <string name="action_open_settings">Open Accessibility Settings</string>
    <string name="action_test_connection">Test Connection</string>
    <!-- Magician bridge pairing -->
    <string name="bridge_section_eyebrow">MAGICIAN</string>
    <string name="bridge_section_title">Connect to Magician</string>
    <string name="bridge_status_unpaired">Not connected. This device dials out to Magician and never listens for connections, so it works from any network without opening a port on your phone.</string>
    <string name="bridge_status_paired">Configured. The bridge connects when the service is running.</string>
    <string name="bridge_status_connected">Connected to Magician.</string>
    <string name="bridge_saved">Saved. Restart the accessibility service to reconnect.</string>
    <string name="bridge_incomplete">A URL and a token are both required.</string>
