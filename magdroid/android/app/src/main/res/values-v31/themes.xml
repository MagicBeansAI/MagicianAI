<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the launch screen's ground with no icon.
         Launchers and OEM skins size and place the splash icon their own way
         (HiOS drew the star far larger than requested, so the hand-off jumped
         and the mark was clipped); SplashActivity draws the only mark. -->
    <style name="Base.Theme.Magdroid.Launch" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/md_theme_light_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
    </style>
</resources>
