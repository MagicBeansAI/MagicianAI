<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the same star SplashActivity draws
         (@drawable/splash_icon), on the same ground, at the same size and
         centre, so the hand-off from the system splash to the launch screen
         does not change the icon's shape, size or position. No icon
         background: the 288dp canvas is masked to a 192dp circle, which the
         132dp star sits inside, so no device mask trims it. -->
    <style name="Base.Theme.Magdroid.Launch" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/md_theme_light_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
