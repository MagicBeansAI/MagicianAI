<?xml version="1.0" encoding="utf-8"?>
<!-- Elevated card on the warm ground: Magician's medium radius and soft border,
     rather than Material's default square-ish surface. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/md_theme_light_surface" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="@color/md_theme_light_outlineVariant" />
</shape>
