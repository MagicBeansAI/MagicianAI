{
  "contract_version": 1,
  "materialized_schema_version": 1,
  "dataset_watermark_schema_version": 1,
  "activation": "active_by_default_phase_2f",
  "content_free": true,
  "datasets": {
    "call_fact": "analytics/llm_calls",
    "provider_attempt": "analytics/llm_provider_attempts",
    "capture_gap": "analytics/llm_capture_gaps"
  },
  "partitioning": {
    "clock": "utc_event_time",
    "layout": "dt=YYYY-MM-DD",
    "object_identity": [
      "record_kind",
      "stable_id",
      "revision"
    ],
    "object_semantics": "one_immutable_raw_revision_per_parquet_object",
    "small_file_compaction_owner": "phase_2d"
  },
  "publication_order": [
    "validate_complete_batch",
    "write_and_fsync_temporary_json",
    "project_explicit_typed_schema_to_temporary_parquet",
    "fsync_temporary_parquet",
    "atomic_rename_to_deterministic_object",
    "fsync_partition_directory",
    "verify_published_identity_and_checksum",
    "atomically_advance_dataset_checksum_watermark",
    "advance_journal_watermark_after_full_batch"
  ],
  "storage_boundary": {
    "scoped_directory_components": "real_directories_only_no_symlink_redirection",
    "immutable_objects_and_watermarks": "regular_files_only_no_symlink_following"
  },
  "idempotency": {
    "same_revision_same_checksum": "verify_and_reuse",
    "same_revision_different_checksum": "fail_closed",
    "object_published_watermark_missing": "verify_object_then_repair_watermark",
    "dataset_watermark_never_moves_backwards": true
  },
  "required_fact_groups": {
    "identity": [
      "journal_sequence",
      "record_kind",
      "stable_id",
      "record_revision",
      "lifecycle_phase",
      "idempotency_key",
      "payload_checksum",
      "principal",
      "workspace",
      "trace_id",
      "llm_call_id",
      "provider_attempt_id",
      "provider_attempt_index",
      "dispatch_job_id"
    ],
    "timing": [
      "created_at_ms",
      "submitted_at_ms",
      "started_at_ms",
      "first_token_at_ms",
      "completed_at_ms",
      "queue_wait_ms",
      "local_prep_ms",
      "provider_execution_ms",
      "ttft_ms",
      "generation_after_ttft_ms",
      "parse_ms",
      "validation_ms",
      "latency_ms"
    ],
    "usage": [
      "input_tokens",
      "output_tokens",
      "reasoning_tokens",
      "cache_read_tokens",
      "cache_creation_tokens",
      "audio_input_tokens",
      "audio_output_tokens",
      "audio_cached_tokens",
      "total_tokens"
    ],
    "pricing": [
      "pricing_version",
      "cost_source",
      "input_cost_usd",
      "output_cost_usd",
      "reasoning_cost_usd",
      "cache_cost_usd",
      "cost_usd"
    ],
    "validation": [
      "response_present",
      "parse_attempted",
      "parse_success",
      "schema_validation_attempted",
      "schema_validation_success",
      "contract_validation_attempted",
      "contract_validation_success",
      "validation_error_class",
      "discarded_before_use",
      "discard_reason",
      "superseded_by_call_id"
    ],
    "capture": [
      "capture_mode",
      "capture_status",
      "training_eligible_at_capture",
      "training_exclusion_reason",
      "gap_id",
      "gap_reason",
      "missing_record_count"
    ]
  },
  "forbidden_content_columns": [
    "prompt",
