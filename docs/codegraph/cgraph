#!/usr/bin/env python3
"""cgraph — Code graph query CLI.

Usage:
  cgraph how <topic>              Architecture explain for a concept
  cgraph endpoints [--crate X]    List API endpoints
  cgraph detail <crate>           Full crate blueprint
  cgraph search <query>           Keyword search
  cgraph flow <endpoint-id>       Run flow simulation

Examples:
  cgraph how approval             → architecture: approval flow types, files, contracts
  cgraph how memory_tier          → architecture: memory tier structs, enums, functions
  cgraph endpoints --crate magician
  cgraph detail bot-sdk           → 6 files, 20 functions, 5 classes
  cgraph search enroll            → keyword search across all nodes

For magician-specific lists (tools / agents / personalities / skills /
Tauri config), use the extension CLIs:
  python3 scripts/codegraph_ext_cli.py skills --type tool
  python3 scripts/codegraph_ext_cli.py tauri  --kind capability
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

CODEGRAPH_DIR = Path(__file__).resolve().parent
REPO_ROOT = CODEGRAPH_DIR.parents[1]
SCRIPTS_DIR = REPO_ROOT / "scripts"
DEFAULT_GRAPH = CODEGRAPH_DIR / "graph.json"

sys.path.insert(0, str(SCRIPTS_DIR))
import query_code_graph as gq  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="cgraph",
        description="Code graph query CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument("--graph", default=str(DEFAULT_GRAPH), help="Path to graph.json")
    parser.add_argument("--compact", "-c", action="store_true", help="Compact JSON output")

    sub = parser.add_subparsers(dest="command")
    common = {"parents": [], "formatter_class": argparse.RawDescriptionHelpFormatter}

    # how
    p_how = sub.add_parser("how", help="Architecture explain for a concept")
    p_how.add_argument("topic", help="Architecture concept (e.g. approval, memory_tier)")
    p_how.add_argument("--compact", "-c", action="store_true", help="Compact JSON")

    # endpoints
    p_ep = sub.add_parser("endpoints", aliases=["ep"], help="List API endpoints")
    p_ep.add_argument("--crate", default=None, help="Filter by crate")
    p_ep.add_argument("--compact", "-c", action="store_true", help="Compact JSON")

    # detail
    p_detail = sub.add_parser("detail", help="Full crate blueprint")
    p_detail.add_argument("crate", help="Crate name")
    p_detail.add_argument("--compact", "-c", action="store_true", help="Compact JSON")

    # search
    p_search = sub.add_parser("search", aliases=["s"], help="Keyword search")
    p_search.add_argument("query", help="Search terms")
    p_search.add_argument("--kind", default=None, help="Node kind filter")
    p_search.add_argument("--depth", type=int, default=1, help="Neighbor depth")
    p_search.add_argument("--limit", type=int, default=20, help="Max results")
    p_search.add_argument("--compact", "-c", action="store_true", help="Compact JSON")

    # flow
    p_flow = sub.add_parser("flow", help="Run flow simulation")
    p_flow.add_argument("source_id", help="Endpoint source ID")
    p_flow.add_argument("--max-hops", type=int, default=6, help="Max traversal hops")
    p_flow.add_argument("--compact", "-c", action="store_true", help="Compact JSON")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 1

    graph = gq.load_graph(args.graph)
    indent = None if args.compact else 2

    # Build namespace for query functions
    ns = argparse.Namespace(
        graph=args.graph,
        how=None,
        query=None,
        pattern=None,
        endpoints=True,
        kind=None,
        limit=20,
        depth=1,
        crate=None,
    )

    if args.command == "how":
        ns.how = args.topic
        result = gq.cmd_how(ns, graph)
    elif args.command in ("endpoints", "ep"):
        ns.crate = getattr(args, "crate", None)
        result = gq.cmd_endpoints(ns, graph)
    elif args.command == "detail":
        ns.pattern = args.crate
        result = gq.cmd_pattern(ns, graph)
    elif args.command in ("search", "s"):
        ns.query = args.query
        ns.kind = getattr(args, "kind", None)
        ns.depth = getattr(args, "depth", 1)
        ns.limit = getattr(args, "limit", 20)
        result = gq.cmd_query(ns, graph)
    elif args.command == "flow":
        try:
            import simulate_code_flow as flow_sim
            result = flow_sim.simulate(
                str(REPO_ROOT / "docs" / "codegraph" / "graph.json"),
                args.source_id,
                max_hops=args.max_hops,
            )
        except ImportError:
            result = {"error": "simulate_code_flow module not available"}
    else:
        parser.print_help()
        return 1

    print(json.dumps(result, indent=indent, default=str))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
