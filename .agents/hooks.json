{
  "docs-remind": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/scripts/docs_remind_hook.sh agy",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "$(git rev-parse --show-toplevel)/scripts/docs_remind_hook.sh agy",
        "timeout": 30
      }
    ]
  }
}
