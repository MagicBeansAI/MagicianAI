{
  "$schema": "https://raw.githubusercontent.com/nicholasgasior/tauri-schema/v2/schema.json",
  "productName": "Magican",
  "version": "0.3.18",
  "identifier": "ai.magicbeans.magican.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://localhost:5173 http://localhost:3002; connect-src 'self' http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:* https: wss:; img-src 'self' http://localhost:5173 data: blob:; style-src 'self' http://localhost:5173 'unsafe-inline'; script-src 'self' http://localhost:5173 'unsafe-inline' 'unsafe-eval'; font-src 'self' http://localhost:5173 data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vosk-model": "vosk-model",
      "../../magicutor/extension": "browser-extension",
      "native-backend": "native-backend"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Magician.entitlements",
      "frameworks": ["vendor/vosk/libvosk.dylib"]
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magican"]
      }
    },
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyMTdBODg2NURCQUZEQzMKUldURC9icGRocWdYY21CTGtlc2l5bHVkL2YwWlJFbUNyUWdkckppVXdVZEFMQTBsNHFESHQ5cGcK",
      "endpoints": [
        "https://github.com/magicbeanbs100x/magician/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
