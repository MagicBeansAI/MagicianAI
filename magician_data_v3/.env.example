# Environment variables for Magician
# Copy this file to .env or .env.development and set real values.
#
# SECRETS MODEL: real secret VALUES live only in .env / .env.development (this
# file's siblings, mode 0600, never committed). operator-config.yaml holds the
# same keys as `${VAR}` REFERENCES, not values — it names which env var supplies
# each secret. The runtime loads .env/.env.development into the process env at
# boot (dotenvy), LLM providers read `api_key_env` from that env, and the
# channel readers (Kapso/AgentMail) read the env var first. Set every secret you
# use below; the placeholders here are non-functional examples.

# Decision engine (hosted TypeSafe Jev). Read by the decision-engine process
# from this file, referenced by models.*.api_key_env in decision-engine.yaml.
# Leave empty to keep hosted decision models idle (steps keep their LLM path).
TYPESAFE_API_KEY=

# Container startup sets both. Desktop-managed native startup also defaults the
# HTTP host to 0.0.0.0 for explicitly selected Same Wi-Fi mobile pairing; set
# 127.0.0.1 here for a deliberately loopback-only service.
# The supervisor maps these to Magician's --host and --frontend-dir arguments.
# MAGICIAN_HTTP_HOST=0.0.0.0
# MAGICIAN_FRONTEND_DIR=/app/ui

# =====================================================================
# OPERATOR IDENTITY  (the identity layer — written by `make setup-identity`)
# =====================================================================
# Single source for every "who am I / who do I serve" value: prompts
# substitute {owner_name} from here, channel code reads the agent's own
# inbox/JID from here, and public-ingress scripts read the zone from here.
# None of these have code defaults — unset means the dependent feature
# declines to start instead of silently using someone else's identity.

# How the agent addresses its owner (prompt placeholder {owner_name})
# MAGICIAN_OWNER_NAME="Alex"

# Principal / scope name for the primary operator
# MAGICIAN_PRINCIPAL="alex"

# The AGENT's own inbox (AgentMail) — replaces the removed DEFAULT_INBOX
# MAGICIAN_AGENT_EMAIL="your-agent@agentmail.to"

# The AGENT's own WhatsApp number (digits only, no +)
# MAGICIAN_AGENT_WHATSAPP_JID="919876543210"

# Public ingress posture chosen at setup: local | quick | named
# MAGICIAN_INGRESS_MODE=local

# Operator Cloudflare zone — required only for MAGICIAN_INGRESS_MODE=named;
# details in the CLOUDFLARE TUNNEL section below. No script defaults this.
# MAGICIAN_TUNNEL_ZONE=example.com

# =====================================================================
# LLM PROVIDER KEYS  (magician-config.yaml profiles read these via api_key_env)
# =====================================================================

# Required when using OpenAI profiles
OPENAI_API_KEY=sk-your-openai-key

# Optional provider keys (only if those profiles are configured)
# ANTHROPIC_API_KEY=sk-ant-your-key
# GEMINI_API_KEY=AIzaSy-your-gemini-key
# DEEPSEEK_API_KEY=sk-deepseek-example-key
# OPENROUTER_API_KEY=your-openrouter-key
# xAI (Grok) — Responses API at https://api.x.ai/v1 (provider: xai profiles)
# XAI_API_KEY=xai-your-xai-key
# Sarvam AI — Indic-first chat models (sarvam-105b) over the OpenAI-compatible
# Chat Completions API at https://api.sarvam.ai (provider: sarvam profiles)
# SARVAM_API_KEY=sk_your-sarvam-key

# MiniMax — chat/reasoning (MiniMax-M2.7 / M3), TTS (speech-02-hd), and the
# mmx-cli media skills (image-01 / Hailuo / music-2.6 / vision / search).
# MINIMAX_API_KEY=your-minimax-key
# MAGICIAN_MINIMAX_GROUP_ID=your-minimax-group-id
# MINIMAX_REGION=global            # or `cn` for a MiniMax-CN key

# =====================================================================
# TOOL & CHANNEL PROVIDER SECRETS
# (operator-config.yaml references each of these via ${VAR})
# =====================================================================

# Tiered web research — TinyFish is the preferred free search adapter and also
# exposes bounded provider-direct fetch; Exa and Tavily remain search fallbacks.
# TINYFISH_API_KEY=your-tinyfish-api-key
# TAVILY_API_KEY=tvly-your-key
# EXA_API_KEY=your-exa-key

# CloakBrowser latest-build license. A free GitHub-issued key permits one
# concurrent CloakBrowser session. This is consumed directly by the browser
# process and has no magician-config.yaml property.
# CLOAKBROWSER_LICENSE_KEY=cb_your-cloakbrowser-key

# Google Gemini API key reused by the nanobanana2 image + veo3.1 video skills
# NANOBANANA2_API_KEY=AIzaSy-your-key
# VEO31_API_KEY=AIzaSy-your-key

# Meme / GIF skills
# KLIPY_API_KEY=your-klipy-key
# IMGFLIP_USERNAME=your-username
# IMGFLIP_PASSWORD=your-password

# Metabase analytics CLI
# METABASE_BASE_URL=https://your.metabaseapp.com
# METABASE_API_KEY=mb_your-key

# GitHub (repo tooling)
# GITHUB_TOKEN=ghp_your-token

# Reddit application-only OAuth. Optional but required for score/upvote/comment
# metrics; the keyless Atom fallback remains available without this pair.
# REDDIT_CLIENT_ID=your-reddit-app-client-id
# REDDIT_CLIENT_SECRET=your-reddit-app-client-secret

# Channels — AgentMail (email), Kapso (WhatsApp), Telegram
# AGENT_MAIL_KEY=am_us_inbox_xxxx
# TELEGRAM_TOKEN=123456789:ABCDEFG-your-bot-token
# KAPSO_API_KEY=your-kapso-key
# KAPSO_PHONE_NUMBER_ID=your-kapso-phone-number-id
# KAPSO_PHONE_NUMBER=your-kapso-phone-number
# Required for the public Kapso receiver. Copy the number-webhook signing secret
# from Kapso Project Settings; inbound POSTs fail closed when it is unset.
# KAPSO_WEBHOOK_SECRET=wh_sec_xxxx
# Pre-approved WhatsApp Utility template used when a reply falls outside Meta's
# 24-hour customer-service window — outside it, free-form text is refused and
# the reply is dropped unless this is set. The template needs exactly one body
# variable with static text on both sides of it; the reply text is substituted
# in. Language defaults to en_US.
# KAPSO_FALLBACK_TEMPLATE_NAME=your-approved-template-name
# KAPSO_FALLBACK_TEMPLATE_LANG=en_US

# Optional typed storage bootstrap (YAML). When unset, local workspace_storage
# is unchanged. Remote documents fail closed before stores open.
# MAGICIAN_STORAGE_BOOTSTRAP_CONFIG=/etc/magician/storage.yaml

# Base URL the runtime advertises to itself / skills
# MAGICIAN_URL=http://127.0.0.1:3002
# Workspace-bound bearer for first-party CLI, skill, and desktop clients.
# NOT for bot daemons: the runtime mints a scoped in-memory token and injects
# MAGICIAN_BEARER_TOKEN when it spawns each bot, then revokes it on stop, so a
# value set here has no effect on them. Mint a PAT for the remaining unattended
# clients; never commit the real value.
# MAGICIAN_BEARER_TOKEN=mag_pat_replace_me
# The stateless per-phase loop is the code default. Set `inprocess` only as an
# explicit rollback; that legacy arm has no durable event-outbox drain.
MAGICIAN_EXECUTION_DRIVER=stateless
# Public HTTPS origin generic iOS and Android builds receive after scanning a
# one-time connection QR. This is deployment config, never compiled into an app.
# MAGICIAN_MOBILE_PUBLIC_ORIGIN=https://mobile.example.com
# MAGICIAN_DEVICE_PUBLIC_ORIGIN remains a compatibility fallback.
# Native non-loopback startup derives the Same Wi-Fi private-LAN origin. An
# operator may override it with a host-reachable private origin or disable it.
# MAGICIAN_MOBILE_LOCAL_ORIGIN=http://192.168.1.20:3002
# MAGICIAN_MOBILE_LOCAL_ORIGIN=off

# Optional outer Cloudflare Access service credential. It stays in runtime env
# and is delivered only through a consumed, five-minute mobile enrollment; it
# is no longer baked into either mobile build.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# Assertion verification values written by `make ios-access` from the actual
# Cloudflare application and Zero Trust organization. `require` rejects an
# unpaired service-token identity even though the shared outer credential was
# accepted at the edge.
# MAGICIAN_CF_ACCESS_TEAM_DOMAIN=https://customer.cloudflareaccess.com
# MAGICIAN_CF_ACCESS_AUD=customer-access-application-audience
# MAGICIAN_CF_ACCESS_MODE=require
# Direct desktop clients through a published container port have no Access JWT.
# Such deployments may use verify only after provisioning an owner and setting
# YAML auth.mode: credentials / auth.allow_signup: false. Keep the public origin
# protected by Access. Do not combine verify with an open owner bootstrap.
# Invalid supplied assertions still fail; ESP bootstrap still requires verified
# Access or a direct backend-loopback peer. Desktop clients need their own bearer.

# Optional mobile remote delivery. Local widget refresh and realtime in-app
# updates keep working when these are absent. APNs uses one token-signing key;
# FCM uses a service-account JSON file for the same Firebase project as the
# deployment's Android google-services.json. Keep both private files outside git.
# MAGICIAN_APNS_KEY_ID=ABC123DEFG
# MAGICIAN_APNS_TEAM_ID=TEAM123456
# MAGICIAN_APNS_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_ABC123DEFG.p8
# MAGICIAN_APNS_TOPIC=com.magicbeans100x.magican
# MAGICIAN_FCM_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json

# Headless Linux containers can use the existing OS Secret Service key backend.
# Pass these at container launch (the entrypoint runs before runtime env loading).
# Mount the private encrypted keyring separately from /data, and mount its
# nonempty random unlock secret read-only with mode 0400/0600. Never put the
# secret itself in environment variables or the image. See container runtime docs.
# MAGICIAN_KEYRING_STATE_DIR=/keyring
# MAGICIAN_KEYRING_PASSWORD_FILE=/run/secrets/magician-keyring-password
# Host-only installer/desktop custody override; export consistently to both.
# It is not a backend runtime setting. Keep it outside MAGICIAN_ROOT_DIR.
# Default: ~/.magician-container-keyrings (private per-runtime subdirectories).
# MAGICIAN_CONTAINER_KEYRING_HOME=/absolute/private/host/container-keyrings

# Cloudflare tunnel/pages tokens (see the CLOUDFLARE sections below)
# CLOUDFLARE_API_TOKEN=token
# MAGICIAN_TUNNEL_MODE=token

# =====================================================================
# CLOUDFLARE TUNNEL (Kapso WhatsApp)
# =====================================================================
# Public ingress for the Kapso WhatsApp webhook (opt-in via MAGICIAN_ENABLE_FUNNEL=1).
# Two auth modes, chosen by MAGICIAN_TUNNEL_MODE:
#   browser (default) — one-time `cloudflared tunnel login` + a locally-managed named tunnel
#   token             — a DASHBOARD-created tunnel run headless with its connector token
#
# A token tunnel's public hostname + DNS live in Cloudflare (not config.yml). If you
# ALSO set CLOUDFLARE_API_TOKEN, the script configures them for you. NEVER put the 
# webhook hostname behind Cloudflare Access — it 302s the sender to a login and breaks delivery.
# MAGICIAN_TUNNEL_MODE=token
# CLOUDFLARED_TOKEN=your-connector-token
# CLOUDFLARE_API_TOKEN=your-api-token
# MAGICIAN_TUNNEL_ZONE=example.com
# MAGICIAN_TUNNEL_UI=0   # webhook-only tunnel: skip the optional dev-UI host (ui.<zone>)
# Stable public origin shared by iOS, Android, ESP32, and future devices.
# The hostname never changes when switching between native and container backends.
# MAGICIAN_CONNECT_HOST=connect.example.com
# MAGICIAN_CONNECT_BACKEND=local  # local | container | remote; selection is always explicit
# MAGICIAN_CONNECT_LOCAL_API_PORT=3002
# MAGICIAN_CONNECT_CONTAINER_API_PORT=13002
# MAGICIAN_CONNECT_REMOTE_URL=https://engine.example.com  # direct HTTPS origin; never the public connect hostname
# `make connect-local` / `make connect-container` preflight the target, update
# the tunnel, then persist the choice. `make connect-status` is read-only.
# MAGICIAN_IOS_HOST and MAGICIAN_API_PORT remain compatibility aliases only.
# During an exact-host migration, token-mode reconciliation can retain routes
# already added to the remote tunnel without switching the primary zone. This
# does not create or authorize the routes; list only aliases already protected
# and published deliberately.
# MAGICIAN_TUNNEL_PRESERVED_REMOTE_HOSTS=webhook.new.example,ui.new.example,connect.new.example,notes.new.example

# =====================================================================
# CLOUDFLARE PAGES (VibeDev static publish)
# =====================================================================
# Required only when magician-config.yaml has vibedev_deploy.enabled=true.
# Prefer managing these from VibeDev Project settings; the UI writes exactly one
# active runtime env file (.env.development in development, .env in production)
# and runs the same non-mutating preflight check against that file.
# Prefer CLOUDFLARE_PAGES_API_TOKEN so tunnel/DNS automation can keep using a
# different CLOUDFLARE_API_TOKEN when needed. The same CLOUDFLARE_API_TOKEN can
# be reused only if it has Pages project and deploy permissions for this account.
# Verify without creating resources:
#   scripts/vibedev-cloudflare-pages-check.sh
# End-to-end smoke publish, explicit because it creates/updates a Pages project:
#   scripts/vibedev-cloudflare-pages-check.sh --publish-smoke
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_PAGES_API_TOKEN=your-pages-api-token
# WRANGLER_BIN=wrangler

# =====================================================================
# SPEECH-TO-TEXT (STT) & TEXT-TO-SPEECH (TTS)
# =====================================================================
# Base URLs if using custom API gateways for STT/TTS
# MAGICIAN_STT_BASE_URL="https://api.openai.com/v1"
# MAGICIAN_TTS_BASE_URL="https://api.openai.com/v1"

# API keys for STT/TTS (defaults to OPENAI_API_KEY if using OpenAI)
# MAGICIAN_STT_API_KEY="sk-..."
# MAGICIAN_TTS_API_KEY="sk-..."

# Model selection for STT and TTS
# MAGICIAN_STT_MODEL="whisper-1"
# MAGICIAN_TTS_MODEL="tts-1"
# MAGICIAN_TTS_VOICE="alloy"
# MAGICIAN_TTS_FORMAT="mp3"

# Performance tuning for TTS
# MAGICIAN_TTS_CACHE_CAPACITY="100"
# MAGICIAN_TTS_SEGMENT_TIMEOUT_SECS="10"

# Minimax TTS (alternative provider)
# MINIMAX_API_KEY="..."
# MAGICIAN_MINIMAX_GROUP_ID="..."
# MAGICIAN_MINIMAX_TTS_BASE_URL="https://api.minimax.chat/v1"
# MAGICIAN_MINIMAX_TTS_MODEL="speech-01"
# MAGICIAN_MINIMAX_TTS_VOICE="male-01"
# MAGICIAN_MINIMAX_TTS_FORMAT="mp3"

# Sarvam speech (STT/TTS) uses the same SARVAM_API_KEY as the Sarvam chat entry
# above. Put the live value in the runtime .env files.

# =====================================================================
# SECURITY & ACCESS
# =====================================================================
# Secret required to perform admin-level actions through the API
# MAGICIAN_ADMIN_SECRET="super_secret_admin_token"

# API key to communicate with the internal resource authority (billing/ceilings)
# RESOURCE_AUTHORITY_API_KEY="..."

# Browser gate strictness (set to "1" or "true" to enforce strict browser gates)
# MAGICIAN_STRICT_BROWSER_GATE="true"

# Envoy owner identities. Values are comma, semicolon, or newline separated and
# are referenced by magician.config.yaml `envoy.owner_identity_envs`.
# Kapso/WhatsApp numbers must match the channel sender exactly, usually without
# a leading "+".
# Telegram private chats use the numeric chat id as the channel address.
# To find yours: DM your bot, then request
#   https://api.telegram.org/bot<TELEGRAM_TOKEN>/getUpdates
# and read result[].message.chat.id. For a private chat this equals your
# Telegram user id. The token is the bot's TELEGRAM_TOKEN (see the telegram
# bot .env). getUpdates only returns data when no webhook is set and while
# magician's telegram bot isn't polling (it would drain the updates first).
# MAGICIAN_OWNER_KAPSO_IDENTITIES="919876543210,918765432109"
# MAGICIAN_OWNER_TELEGRAM_IDENTITIES="123456789"
# MAGICIAN_OWNER_AGENTMAIL_IDENTITIES="owner@example.com,backup-owner@example.com,work-owner@example.com"

# =====================================================================
# ORCHESTRATION & AGENT HARNESS
# =====================================================================
# Emergency override for the config-backed Crew harness switch. Prefer the
# Crew page or harness.paused; a Crew mutation removes this override.
# MAGICIAN_HARNESS_PAUSED="false"

# Maximum duration an agent can run an autonomous loop before yielding (seconds)
# MAGICIAN_AGENTIC_MAX_DURATION_SECS="300"

# Per-run USD ceiling for one agentic execution. Default 15 when unset
# (5 until 0.7.62); an explicit 0 disables the ceiling (token meter only).
# A run that reaches it pauses as BudgetExhausted and asks the operator to
# continue. Sizing note: a GPT-5.6 Terra browser run costs ~$1–2; a Fable 5.1
# decider spends ~$0.45 a turn on the browser tool set alone and exhausted
# $5 in ten decides, before extraction.
# MAGICIAN_AGENTIC_MAX_COST_USD="15"

# Capture a backtrace wherever an execution is cancelled, so an unexplained
# cancel names its caller instead of only its constant reason. Off by default;
# it costs nothing unset. This is what identified the chat-harness cascade that
# tore delegated runs down when their chat turn merely ended.
# MAGICIAN_CANCEL_BACKTRACE="1"

# Feature flags for orchestration routing
# MAGICIAN_ORCHESTRATE_PIPELINE_SINGLE_CONTEXT="true"
# MAGICIAN_ORCHESTRATE_DECOMPOSE="true"
# MAGICIAN_VIBEDEV_SUCCESS_GATE="true"
# MAGICIAN_TASK_SYNTHESIS_ROOT_GATE="true"

# Polling tick interval for the harness steward
# MAGICIAN_HARNESS_STEWARD_TICK="5"

# The gateway URL the host process exposes to sub-agents
# MAGICIAN_HOST_GATEWAY_URL="http://127.0.0.1:8080"

# Disable direct agentic execution endpoints (skip_planning/start)
# MAGICIAN_DISABLE_AGENTIC_DIRECT=false

# =====================================================================
# MEETING BOT & APPS
# =====================================================================
# Audio devices come from `make install` / `make setup-meet-bot`, not from
# these variables. macOS speak: BlackHole 16ch, then reboot. macOS listen:
# Screen Recording permission and magician-macos-meet-audio.bin. Linux:
# Pulse tools (pactl, parec, pacat) and Xvfb. The bot creates
# magician_meet_mic and magician_meet_capture null-sinks at join time.
# Calendar accounts (comma separated) for the meet bot to sync with
# MEET_BOT_CALENDAR_ACCOUNTS="hello@example.com,work@example.com"
# MEET_BOT_CALENDAR_ACCOUNT="hello@example.com"

# =====================================================================
# MEMORY & ANALYTICS JOBS
# =====================================================================
# Toggle flags for memory background processes
# MAGICIAN_MEMORY_INDEX_MAINTAINER="1"
# MAGICIAN_MEMORY_UTILITY_BATCH_RUNNER="1"
# AMBIENT_DISTILL_ENABLED="1"

# Durable memory-utility maintenance. Completed runs enqueue bounded snapshots
# on disk; the runner claims at most two items globally per tick, one at a
# time, and yields while foreground or same-provider background LLM work is
# active. Failed items use leases plus capped exponential retry rather than
# being lost with the process. These are emergency scheduling overrides; the
# small defaults protect an Ollama runtime configured with NUM_PARALLEL=1.
# MAGICIAN_MEMORY_UTILITY_BATCH_INTERVAL_SECS="60"
# MAGICIAN_MEMORY_UTILITY_BATCH_STARTUP_DELAY_SECS="180"
# MAGICIAN_MEMORY_UTILITY_BATCH_MIN_SIZE="1"
# MAGICIAN_MEMORY_UTILITY_BATCH_MAX_SIZE="2"

# Memory index maintenance knobs. Embedding endpoint, residency, query/write
# budgets, model, context, dimensions, and batching are config-first under
# runtime.ollama. The values below are emergency env overrides only.
# MAGICIAN_MEMORY_INDEX_INTERVAL_SECS="21600"
# MAGICIAN_MEMORY_INDEX_DEBOUNCE_SECS="1200"
# MAGICIAN_OLLAMA_EMBEDDING_TIMEOUT_MS="180000"
# MAGICIAN_MEMORY_EMBEDDING_TIMEOUT_MS="180000"
# MAGICIAN_MEMORY_QUERY_EMBEDDING_TIMEOUT_MS="5000"
# MAGICIAN_MEMORY_LANCEDB_RETRIEVAL_TIMEOUT_MS="750"
# Restart-bound. `ambient` polls Lance/DataFusion on the caller runtime.
# MAGICIAN_LANCE_RUNTIME="dedicated"
# Restart-bound kill switch. A positive integer is the request-path lance
# search permit count and overrides runtime.scale lance_search_cost_units.
# MAGICIAN_LANCE_SEARCH_CONCURRENCY="4"
# Restart-bound kill switch for Magician-owned spawn_blocking admission.
# `off` / `pass_through` / `0` / `false` skips the semaphore (observe-only
# in-flight). Does not shrink Tokio max_blocking_threads.
# MAGICIAN_BLOCKING_ADMISSION="off"
# Restart-bound. Overrides runtime.scale.profile at boot.
# current | small_cpu | m2_max | cloud_heavy | auto
# MAGICIAN_SCALE_PROFILE="current"
# Restart-bound. `pass_through` restores request-path journal file locks.
# MAGICIAN_MEMORY_INDEX_READ_SNAPSHOT="enabled"
# Restart-bound hybrid score-map cache. Default on in Magician YAML.
# `off`/`pass_through` is the kill switch even when YAML enabled is true.
# MAGICIAN_MEMORY_HYBRID_RESULT_CACHE="off"
# Restart-bound. `off` disables cross-request Lance table reuse.
# Hybrid search still opens the table once per request.
# MAGICIAN_LANCE_TABLE_POOL="on"
# Restart-bound exact-query embedding LRU. Default on in Magician YAML.
# MAGICIAN_QUERY_VECTOR_CACHE="off"
# Restart-bound hybrid vector-leg mode. YAML default is `flat` (exhaustive
# KNN with bypass_vector_index). `ann_shadow` serves flat while recording
# recall; `ann` activates IVF_PQ + exact rerank with flat fallback.
# Invalid values are ignored. Requires a magician restart.
# MAGICIAN_VECTOR_SEARCH="flat"
# Restart-bound query embedding micro-batch. Magician YAML default is
# window 3 ms / max items 8. `off` forces pass-through even if YAML is raised.
# A lone chat miss still flushes immediately.
# MAGICIAN_EMBEDDING_QUERY_BATCH="off"
# MAGICIAN_MEMORY_LANCEDB_HEALTH_CHECK_TIMEOUT_MS="5000"
# MAGICIAN_MEMORY_LANCEDB_OPTIMIZE_TIMEOUT_MS="60000"
# MAGICIAN_MEMORY_INDEX_WRITE_LOCK_TIMEOUT_MS="120000"
# MAGICIAN_OLLAMA_EMBEDDING_WARMUP_TIMEOUT_MS="300000"
# MAGICIAN_MEMORY_EMBEDDING_WARMUP_TIMEOUT_MS="300000"
# MAGICIAN_MEMORY_EMBEDDING_MAX_BATCH_CHARS="6000"
# MAGICIAN_MEMORY_EMBEDDING_RETRIES="0"
# MAGICIAN_MEMORY_EMBEDDING_RETRY_BACKOFF_MS="1500"
# MAGICIAN_MEMORY_EMBEDDING_WARMUP="false"
# Embedding model, context, batching, and physical capacity live exclusively
# under runtime.ollama in magician-config.yaml. These remaining daemon controls
# are generation settings or temporary launch overrides for constrained hosts.
# MAGICIAN_OLLAMA_MAX_LOADED_MODELS="2"
# Generation model/context are selected by llm.router.operation_mapping and the
# referenced profile's model + metadata.options.num_ctx; they have no env fallback.
# MAGICIAN_OLLAMA_KV_CACHE_TYPE="q8_0"
# MAGICIAN_OLLAMA_FLASH_ATTENTION="true"
# MAGICIAN_OLLAMA_PREWARM="true"
# MAGICIAN_OLLAMA_REPLACE_EXISTING_LOCAL_DAEMON="true"
# Embedding-daemon host QoS. Default background (macOS taskpolicy -b;
# Linux nice -n 10). Kill switch: off / pass_through / 0 / false.
# Never pins Magician execution workers. Linux CPU list is optional:
# MAGICIAN_OLLAMA_EMBEDDING_CPUSET="0-1" uses taskset -c instead of nice.
# MAGICIAN_OLLAMA_EMBEDDING_QOS="background"
# MAGICIAN_OLLAMA_EMBEDDING_CPUSET="0-1"
# DRY_RUN=1 or --dry-run prints env + wrap + ollama serve and exits 0 without
# starting a daemon. DRY_RUN=prefix prints only the wrap (no config/ruby).
# MAGICIAN_OLLAMA_EMBEDDING_QOS_DRY_RUN="prefix"

# Comms evidence already groups messages by channel/account/day. Keep its
# distillation, classification, and promotion cadence behind user work.
# CHANNEL_DISTILL_CONCURRENCY="1"
# CHANNEL_DISTILL_INTERVAL_SECS="60"
# CHANNEL_CLASSIFY_CONCURRENCY="1"
# CHANNEL_CLASSIFY_INTERVAL_SECS="120"
# CHANNEL_EVIDENCE_BRIDGE_INTERVAL_SECS="1800"
# CHANNEL_RECONCILE_STALE_DAYS="30"
# CHANNEL_TODAY_PROJECTION_LATENCY_BUDGET_MS="250"
# CHANNEL_FEEDBACK_BRIDGE_ENABLED="true"
# CHANNEL_PATTERN_SYNTHESIS_ENABLED="true"

# Periodic memory retrieval evaluations are diagnostic work and opt in. Manual
# dashboard/API runs remain available regardless of this flag.
# MAGICIAN_MEMORY_EVAL_ENABLED="false"

# Query bounds for memory events
# MAGICIAN_MEMORY_EVENTS_QUERY_MAX_PARQUET_FILES="50"

# =====================================================================
# OPTIONAL RUNTIME FLAGS
# =====================================================================
# Single-tenant scope used by all requests (request-supplied scope is ignored)
# MAGICIAN_DEFAULT_PRINCIPAL=anonymous
# MAGICIAN_DEFAULT_WORKSPACE=default

# Human-visible Notes Space. Keep this separate from MAGICIAN_ROOT_DIR so the
# SilverBullet UI cannot browse canonical runtime/config files. Existing scoped
# notes settings override these setup defaults.
# Default: $MAGICIAN_ROOT_DIR/MagicanNotes (or ~/MagicianNotes/MagicanNotes).
# MAGICIAN_NOTES_SPACE="/absolute/path/to/a/dedicated/notes/space"
# Optional explicit scoped settings file for the SilverBullet sidecar launcher;
# normally it prefers $MAGICIAN_ROOT_DIR/scopes/<principal>/<workspace>/notes/settings.json.
# MAGICIAN_NOTES_SETTINGS_PATH="/path/to/scopes/anonymous/default/notes/settings.json"
# MAGICIAN_SILVERBULLET_LOCAL_URL="http://127.0.0.1:3021"
# Optional protected HTTPS destination opened by web and embedded by Magios.
# MAGICIAN_SILVERBULLET_PUBLIC_ORIGIN="https://notes.example.com"
# Dedicated tunnel hostname. `make ensure-tunnel` ignores it until
# `make notes-access` has verified both service-token and owner Allow policies.
# MAGICIAN_NOTES_HOST="notes.example.com"
# MAGICIAN_NOTES_TUNNEL_ENABLED="auto"
# Access verification is deliberately short-lived when regenerating ingress.
# `make ensure-notes-tunnel` refreshes it immediately before tunnel mutation.
# MAGICIAN_NOTES_ACCESS_ATTESTATION_MAX_AGE_SECONDS="900"
# Required by `make notes-access`; use one or both owner allowlist forms.
# MAGICIAN_NOTES_ACCESS_EMAILS="owner@example.com"
# MAGICIAN_NOTES_ACCESS_EMAIL_DOMAIN="example.com"
# MAGICIAN_NOTES_ACCESS_SESSION="720h"
# Access service-secret rotation is staged with a grace period so installed
# phones can move to the successor before the previous secret is expired.
# Defaults to 72 hours; the scripts enforce a minimum of five minutes.
# MAGICIAN_IOS_ACCESS_ROTATION_GRACE_SECONDS="259200"
# Optional exact-host HTTPS probe; defaults to https://$MAGICIAN_NOTES_HOST/ when
# rotation is run through the Notes Make targets.
# MAGICIAN_IOS_ACCESS_ROTATION_VERIFY_URL="https://notes.example.com/"
# Live route/sidecar recovery drills also require an explicit per-command LIVE=1;
# these are documented here only as non-secret operational knobs.
# MAGICIAN_NOTES_DRILL_WAIT_SECONDS="90"

# Agent-created, unscheduled leaf tasks auto-dispatch by default. Set false to
# leave every such task ready for manual launch. The one-time orphan reconciler
# remains opt-in and can also be invoked safely through the dry-run-first CLI.
# MAGICIAN_AUTO_DISPATCH_CREATED_TASKS="true"
# MAGICIAN_RECONCILE_ORPHANED_TASKS_ON_BOOT="false"

# Full prompt dumps for successful inline-chat provider calls are expensive
# diagnostics and default off. When explicitly enabled, bounded dumps are
# persisted asynchronously; provider-failure dumps remain available regardless.
# MAGICIAN_CHAT_SUCCESS_PROMPT_DUMPS="false"

# Allow operator-approved writes OUTSIDE the scoped workspace. Out-of-workspace
# write_file/edit_file then escalate to the sandbox-override HITL and, once an
# operator approves a root, stage + apply there (double-gated: sandbox-override ->
# diff-approval). OPT-IN and safe because the trusted-store integrity layer binds
# the approved apply to an in-process authority the shell cannot forge; a forged or
# tampered on-disk record is rejected fail-closed. Accepts 1/true/yes/on. Default off.
# See docs/components/magician/trusted-store-integrity.md.
# MAGICIAN_ALLOW_EXTERNAL_WRITES=false

# Override logging level for local runs
# RUST_LOG=info

# =====================================================================
# NOTES
# =====================================================================
# Most runtime configuration should be defined in:
# - tool-runtime-config.yaml
# - magician/magician-config.yaml
# Required for Android Apps automation. This must name a private, regular
# service-account JSON file authorized for the Play Integrity API. Never place
# the JSON/private key in magician.config.yaml or source control.
MAGICIAN_PLAY_INTEGRITY_SERVICE_ACCOUNT_PATH=

# Auth social-login client secrets (docs/components/magician/auth.md).
# Client ids live in magician-config.yaml under auth.providers; the secrets
# stay here. Empty = that provider's routes answer 503 until configured.
MAGICIAN_AUTH_GOOGLE_CLIENT_SECRET=
MAGICIAN_AUTH_GITHUB_CLIENT_SECRET=

# Task Recipes fixture eval (`make test-task-recipes-fixture-eval`): login used
# to create and scope the disposable `recipes-eval` workspace. Leave empty to
# use MAGICIAN_BEARER_TOKEN instead (it must be bound to that workspace).
MAGICIAN_EVAL_USERNAME=
MAGICIAN_EVAL_PASSWORD=
# Optional desktop CUA executable override (all desktop OSes).
# MAGICIAN_CUA_DRIVER_BIN=/absolute/path/to/cua-driver
# Windows default is %LOCALAPPDATA%\Programs\Cua\cua-driver\bin\cua-driver.exe.
# Run scripts/setup-cua-driver.py on the desktop; headless containers use its relay.
