          "sy-((ex-sx)/sqrt((ex-sx)*(ex-sx)+(ey-sy)*(ey-sy)))*size"
        ],
        "to": [
          "sx+(-(ey-sy)/sqrt((ex-sx)*(ex-sx)+(ey-sy)*(ey-sy)))*size",
          "sy+((ex-sx)/sqrt((ex-sx)*(ex-sx)+(ey-sy)*(ey-sy)))*size"
        ]
      },
      {
        "op": "line",
        "from": [
          "ex-(-(ey-sy)/sqrt((ex-sx)*(ex-sx)+(ey-sy)*(ey-sy)))*size",
          "ey-((ex-sx)/sqrt((ex-sx)*(ex-sx)+(ey-sy)*(ey-sy)))*size"
        ],
        "to": [
          "ex+(-(ey-sy)/sqrt((ex-sx)*(ex-sx)+(ey-sy)*(ey-sy)))*size",
          "ey+((ex-sx)/sqrt((ex-sx)*(ex-sx)+(ey-sy)*(ey-sy)))*size"
        ]
      },
